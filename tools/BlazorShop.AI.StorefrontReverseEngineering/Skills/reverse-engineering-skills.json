{
  "schemaVersion": "1.0",
  "skills": [
    {
      "name": "storefront-reference-reconnaissance",
      "version": "1.0",
      "category": "discovery",
      "purpose": "Profile the configured reference URL and record blockers before capture.",
      "inputs": [ "visual-project", "configuration" ],
      "outputs": [ "reference-site-profile", "reconnaissance", "capture-plan" ],
      "dependencies": [ "IReferenceBrowser", "VisualDiscoveryService" ],
      "executionType": "Deterministic",
      "humanReviewRequired": false,
      "completionCriteria": [ "site profile written", "blockers recorded", "capture plan bounded" ],
      "forbiddenActions": [ "crawl beyond maximumPages", "bypass authentication" ]
    },
    {
      "name": "stabilize-reference-page",
      "version": "1.0",
      "category": "capture",
      "purpose": "Apply deterministic wait and warm-scroll stabilization before evidence capture.",
      "inputs": [ "BrowserPageSession", "CapturePolicy" ],
      "outputs": [ "PageStabilizationReport" ],
      "dependencies": [ "StableFullPageCaptureService" ],
      "executionType": "Deterministic",
      "humanReviewRequired": false,
      "completionCriteria": [ "stabilization steps recorded", "noise selectors recorded" ],
      "forbiddenActions": [ "mutate protected flows", "submit forms" ]
    },
    {
      "name": "capture-stable-full-page",
      "version": "1.0",
      "category": "capture",
      "purpose": "Capture full-page screenshot evidence with native and stitched fallback metadata.",
      "inputs": [ "BrowserPageSession", "ViewportDefinition", "CapturePolicy" ],
      "outputs": [ "capture-manifest", "capture-quality-report" ],
      "dependencies": [ "IReferenceBrowser", "StableFullPageCaptureService" ],
      "executionType": "Deterministic",
      "humanReviewRequired": false,
      "completionCriteria": [ "screenshot exists", "capture method recorded", "quality report passed or blocked clearly" ],
      "forbiddenActions": [ "store unlimited segments", "ignore failed quality checks" ]
    },
    {
      "name": "capture-responsive-evidence",
      "version": "1.0",
      "category": "capture",
      "purpose": "Capture configured desktop, tablet, and mobile viewport evidence.",
      "inputs": [ "capture-plan" ],
      "outputs": [ "viewport manifests" ],
      "dependencies": [ "VisualCaptureService" ],
      "executionType": "Deterministic",
      "humanReviewRequired": false,
      "completionCriteria": [ "all configured viewports captured", "viewport IDs linked" ],
      "forbiddenActions": [ "invent unconfigured viewports" ]
    },
    {
      "name": "discover-visual-interactions",
      "version": "1.0",
      "category": "interaction",
      "purpose": "Capture explicitly configured safe interaction states.",
      "inputs": [ "InteractionCapturePlan" ],
      "outputs": [ "interaction-evidence" ],
      "dependencies": [ "InteractionCaptureService" ],
      "executionType": "Deterministic",
      "humanReviewRequired": true,
      "completionCriteria": [ "before/after evidence written", "unsafe selectors refused" ],
      "forbiddenActions": [ "checkout", "login", "payment", "account mutation", "form submit" ]
    },
    {
      "name": "extract-visual-evidence",
      "version": "1.0",
      "category": "evidence",
      "purpose": "Normalize bounded DOM, styles, boxes, and asset evidence.",
      "inputs": [ "BrowserCaptureResult" ],
      "outputs": [ "computed-style-evidence", "asset-inventory", "capture-manifest" ],
      "dependencies": [ "VisualEvidenceExtractor" ],
      "executionType": "Deterministic",
      "humanReviewRequired": false,
      "completionCriteria": [ "evidence bounded", "references validate", "assets reference-only" ],
      "forbiddenActions": [ "download full asset mirrors", "store every DOM node style" ]
    },
    {
      "name": "analyze-page-topology",
      "version": "1.0",
      "category": "analysis",
      "purpose": "Draft neutral page topology from evidence.",
      "inputs": [ "computed-style-evidence" ],
      "outputs": [ "page-topology-draft" ],
      "dependencies": [ "IVisualAnalysisProvider" ],
      "executionType": "Hybrid",
      "humanReviewRequired": true,
      "completionCriteria": [ "sections reference evidence", "confidence recorded" ],
      "forbiddenActions": [ "generate Razor", "copy source layout code" ]
    },
    {
      "name": "create-visual-specification-draft",
      "version": "1.0",
      "category": "analysis",
      "purpose": "Create neutral page/component/blueprint draft artifacts.",
      "inputs": [ "page-topology-draft", "asset-inventory" ],
      "outputs": [ "page-specification-draft", "component-specification-draft", "visual-blueprint-draft" ],
      "dependencies": [ "RuleBasedVisualAnalysisProvider" ],
      "executionType": "Hybrid",
      "humanReviewRequired": true,
      "completionCriteria": [ "drafts reference evidence", "unsupported patterns warned" ],
      "forbiddenActions": [ "emit Blazor component source", "require external AI" ]
    },
    {
      "name": "audit-reference-originality",
      "version": "1.0",
      "category": "provenance",
      "purpose": "Flag reference-only assets, likely brand material, and source copy for review.",
      "inputs": [ "asset-inventory", "computed-style-evidence" ],
      "outputs": [ "originality-audit" ],
      "dependencies": [ "OriginalityAuditService" ],
      "executionType": "Deterministic",
      "humanReviewRequired": true,
      "completionCriteria": [ "reference-only assets recorded", "restrictions machine-readable" ],
      "forbiddenActions": [ "declare legal safety", "reuse source assets by default" ]
    },
    {
      "name": "validate-visual-evidence",
      "version": "1.0",
      "category": "validation",
      "purpose": "Validate schemas, referenced files, provenance, and readiness.",
      "inputs": [ "project artifacts" ],
      "outputs": [ "readiness-report" ],
      "dependencies": [ "IVisualSchemaRegistry", "IVisualArtifactStore" ],
      "executionType": "Deterministic",
      "humanReviewRequired": false,
      "completionCriteria": [ "schema validation pass", "missing files fail", "readiness report written" ],
      "forbiddenActions": [ "treat markdown as source of truth" ]
    }
  ]
}

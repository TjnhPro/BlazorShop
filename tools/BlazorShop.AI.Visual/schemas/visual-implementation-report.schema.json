{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blazorshop.local/schemas/visual-implementation-report.schema.json",
  "title": "Storefront Visual Implementation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operationId",
    "checkpointPath",
    "beforeSnapshotHash",
    "afterSnapshotHash",
    "changedFiles",
    "changedFileTargets",
    "recorderResultPath",
    "buildResult",
    "boundaryResult",
    "unresolvedItems"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "operationId": { "type": "string", "minLength": 1 },
    "checkpointPath": { "type": "string", "minLength": 1 },
    "beforeSnapshotHash": { "type": "string" },
    "afterSnapshotHash": { "type": "string" },
    "changedFiles": { "type": "array", "items": { "type": "string" } },
    "changedFileTargets": { "type": "array", "items": { "$ref": "#/$defs/fileTarget" } },
    "recorderResultPath": { "type": "string" },
    "buildResult": { "$ref": "#/$defs/result" },
    "boundaryResult": { "$ref": "#/$defs/result" },
    "unresolvedItems": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "status", "command" ],
      "properties": {
        "status": { "type": "string", "enum": [ "passed", "failed", "skipped" ] },
        "command": { "type": "string" },
        "reportPath": { "type": "string" }
      }
    },
    "fileTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "filePath", "project", "projectRelativePath" ],
      "properties": {
        "filePath": { "type": "string", "minLength": 1 },
        "project": { "type": "string", "enum": [ "server", "wasm" ] },
        "projectRelativePath": { "type": "string", "minLength": 1 }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blazorshop.local/schemas/visual-qa-report.schema.json",
  "title": "Storefront Visual QA Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operationId",
    "runtimeEvidencePaths",
    "referenceEvidencePaths",
    "pageViewportCoverage",
    "independentReviewer",
    "comparisonDimensions",
    "unacceptedCriticalCount",
    "unacceptedMajorCount",
    "finalDecision",
    "viewportCaptures",
    "evidencePaths",
    "issues",
    "repairAttempts",
    "passed"
  ],
  "properties": {
    "schemaVersion": { "type": "string" },
    "operationId": { "type": "string", "minLength": 1 },
    "runtimeEvidencePaths": { "type": "array", "items": { "type": "string" } },
    "referenceEvidencePaths": { "type": "array", "items": { "type": "string" } },
    "pageViewportCoverage": { "type": "array", "items": { "$ref": "#/$defs/pageViewportCoverage" } },
    "independentReviewer": { "type": "string", "minLength": 1 },
    "comparisonDimensions": { "type": "array", "items": { "type": "string" } },
    "unacceptedCriticalCount": { "type": "integer" },
    "unacceptedMajorCount": { "type": "integer" },
    "finalDecision": { "type": "string", "enum": [ "passed", "failed", "blocked" ] },
    "viewportCaptures": { "type": "array", "items": { "$ref": "#/$defs/viewportCapture" } },
    "evidencePaths": { "type": "array", "items": { "type": "string" } },
    "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
    "repairAttempts": { "type": "array", "items": { "$ref": "#/$defs/repairAttempt" } },
    "passed": { "type": "boolean" }
  },
  "$defs": {
    "viewportCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "pageId", "viewport", "screenshotPath", "status" ],
      "properties": {
        "pageId": { "type": "string" },
        "viewport": { "type": "string", "enum": [ "desktop", "tablet", "mobile" ] },
        "screenshotPath": { "type": "string" },
        "status": { "type": "string", "enum": [ "passed", "failed" ] }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "id", "severity", "message", "targetFileHints" ],
      "properties": {
        "id": { "type": "string" },
        "severity": { "type": "string", "enum": [ "info", "warning", "error", "blocked" ] },
        "message": { "type": "string" },
        "targetFileHints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "repairAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "attempt", "source", "status" ],
      "properties": {
        "attempt": { "type": "integer" },
        "source": { "type": "string", "enum": [ "manual-agent-edit", "mechanical-repair-helper", "no-repair-attempted" ] },
        "status": { "type": "string", "enum": [ "passed", "failed", "skipped" ] },
        "reportPath": { "type": "string" }
      }
    },
    "pageViewportCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "pageId", "viewports" ],
      "properties": {
        "pageId": { "type": "string", "minLength": 1 },
        "viewports": { "type": "array", "items": { "type": "string", "enum": [ "desktop", "tablet", "mobile" ] } }
      }
    }
  }
}

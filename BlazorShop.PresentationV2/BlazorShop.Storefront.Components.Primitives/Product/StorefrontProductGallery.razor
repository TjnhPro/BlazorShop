@namespace BlazorShop.Storefront.Components.Primitives.Product

@if (Gallery.HasItems && Gallery.SelectedItem is { } main)
{
    <div class="@Classes.Root" data-storefront-product-gallery>
        <div class="@Classes.Main" data-storefront-gallery-main>
            <img src="@main.ImageUrl"
                 alt="@Gallery.SelectedAltText"
                 class="@Classes.MainImage"
                 loading="eager"
                 onerror="@BrokenImageFallbackScript"
                 data-storefront-gallery-main-image />
            <div class="@Classes.Placeholder"
                 role="img"
                 aria-label="@FallbackAltText"
                 data-storefront-gallery-placeholder
                 hidden>
                @Labels.ImageUnavailableText
            </div>

            @if (Gallery.HasMultipleItems)
            {
                <div class="@Classes.Controls" data-storefront-gallery-controls>
                    <button type="button"
                            class="@Classes.PreviousButton"
                            aria-label="@Labels.PreviousImage"
                            aria-disabled="@(!Gallery.CanSelectPrevious).ToString().ToLowerInvariant()"
                            data-storefront-gallery-prev
                            disabled="@(!Gallery.CanSelectPrevious)">
                        <svg class="@Classes.Icon"
                             aria-hidden="true"
                             viewBox="0 0 24 24"
                             focusable="false">
                            <path d="M15 18 9 12l6-6" />
                        </svg>
                    </button>
                    <button type="button"
                            class="@Classes.NextButton"
                            aria-label="@Labels.NextImage"
                            aria-disabled="@(!Gallery.CanSelectNext).ToString().ToLowerInvariant()"
                            data-storefront-gallery-next
                            disabled="@(!Gallery.CanSelectNext)">
                        <svg class="@Classes.Icon"
                             aria-hidden="true"
                             viewBox="0 0 24 24"
                             focusable="false">
                            <path d="m9 18 6-6-6-6" />
                        </svg>
                    </button>
                </div>
            }
        </div>

        @if (Gallery.HasMultipleItems)
        {
            <div class="@Classes.ThumbnailViewport"
                 data-storefront-gallery-thumb-viewport
                 role="list"
                 aria-label="@Labels.ImagesRegion">
                @for (var index = 0; index < Gallery.Items.Count; index++)
                {
                    var item = Gallery.Items[index];
                    <button type="button"
                            class="@Classes.Thumbnail"
                            aria-label="@Labels.FormatImageButton(index + 1)"
                            aria-current="@(index == Gallery.SelectedIndex ? "true" : "false")"
                            aria-selected="@(index == Gallery.SelectedIndex ? "true" : "false")"
                            data-selected="@(index == Gallery.SelectedIndex ? "true" : "false")"
                            data-storefront-gallery-thumbnail
                            data-gallery-index="@index"
                            data-image-url="@item.ImageUrl"
                            data-alt="@item.AltText">
                        <img src="@item.ThumbnailUrl"
                             alt=""
                             class="@Classes.ThumbnailImage"
                             loading="lazy"
                             onerror="@BrokenImageFallbackScript" />
                        <span class="@Classes.ThumbnailFallback"
                              data-storefront-gallery-thumb-fallback
                              hidden>
                            @Labels.ImageUnavailableText
                        </span>
                    </button>
                }
            </div>
        }
    </div>
}
else
{
    <div class="@Classes.Root" data-storefront-product-gallery>
        <div class="@Classes.Main" data-storefront-gallery-main>
            <div class="@Classes.Placeholder"
                 role="img"
                 aria-label="@FallbackAltText"
                 data-storefront-gallery-placeholder>
                @Labels.ImageUnavailableText
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public IReadOnlyList<ProductGalleryItem> Items { get; set; } = [];

    [Parameter]
    public string? ProductName { get; set; }

    [Parameter]
    public ProductGalleryLabels Labels { get; set; } = ProductGalleryLabels.Empty;

    [Parameter]
    public ProductGalleryClasses Classes { get; set; } = new();

    private ProductGalleryState Gallery => ProductGalleryState.Create(Items, ProductName);

    private string FallbackAltText => Labels.FormatImageUnavailableAlt(Gallery.DisplayProductName);

    private const string BrokenImageFallbackScript = "this.onerror=null;this.hidden=true;this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221%22 height=%221%22/%3E';if(this.nextElementSibling){this.nextElementSibling.hidden=false;}";
}

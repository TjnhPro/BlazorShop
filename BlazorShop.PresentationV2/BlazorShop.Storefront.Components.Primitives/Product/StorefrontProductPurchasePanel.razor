@namespace BlazorShop.Storefront.Components.Primitives.Product
@using BlazorShop.Storefront.Components.Headless.Product

<div id="@Actions.PanelId"
     class="@Classes.Root"
     data-storefront-product-purchase
     data-selection-preview-route="@Actions.SelectionPreviewRoute"
     data-product-id="@Model.ProductId"
     data-product-name="@Model.ProductName"
     data-currency-code="@Model.CurrencyCode"
     data-resolved-variant-id="@Model.ResolvedVariantId"
     data-main-image-url="@Model.InitialMainImageUrl"
     data-sku="@Model.InitialSku"
     data-gtin="@Model.InitialGtin"
     data-storefront-product-purchase-panel>
    <p class="@Classes.Heading">@Labels.PurchaseHeading</p>
    <p class="@Classes.Message">@Model.PurchaseMessage</p>
    @if (!Model.CanSubmitInitialPurchase)
    {
        <p class="@Classes.BlockedMessage">@Model.PurchaseBlockMessage</p>
    }
    @if (!string.IsNullOrWhiteSpace(Model.DeliveryEstimateText) || Model.FreeShipping)
    {
        <div class="@Classes.DeliveryMetadata">
            @if (Model.FreeShipping)
            {
                <span class="@Classes.FreeShippingBadge">@Labels.FreeShipping</span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.DeliveryEstimateText))
            {
                <span class="@Classes.DeliveryEstimateBadge">@Model.DeliveryEstimateText</span>
            }
        </div>
    }

    @if (Snapshot.HasVariationTemplate)
    {
        <div class="@Classes.OptionGroups" data-storefront-attribute-group>
            @foreach (var option in Model.VariationOptions)
            {
                <fieldset class="@Classes.OptionGroup" id="@OptionInputId(option)">
                    <legend class="@Classes.OptionLegend">
                        <span>@option.Name</span>
                        @if (!option.IsRequired)
                        {
                            <span class="@Classes.OptionalLabel">@Labels.Optional</span>
                        }
                    </legend>

                    @if (IsRadioControl(option))
                    {
                        <div class="@Classes.OptionChoices">
                            @foreach (var value in ActiveVariationValues(option))
                            {
                                var inputId = OptionValueInputId(option, value);
                                <label class="@Classes.OptionChoice">
                                    <input id="@inputId"
                                           type="radio"
                                           name="@OptionInputName(option)"
                                           value="@value.Value"
                                           checked="@value.IsSelected"
                                           data-storefront-purchase-attribute
                                           data-storefront-purchase-attribute-name="@option.Name"
                                           class="@Classes.OptionInput" />
                                    <span>@value.Value</span>
                                </label>
                            }
                        </div>
                    }
                    else if (IsColorControl(option))
                    {
                        <div class="@Classes.OptionChoices">
                            @foreach (var value in ActiveVariationValues(option))
                            {
                                var inputId = OptionValueInputId(option, value);
                                <label class="@Classes.OptionChoice">
                                    <input id="@inputId"
                                           type="radio"
                                           name="@OptionInputName(option)"
                                           value="@value.Value"
                                           checked="@value.IsSelected"
                                           data-storefront-purchase-attribute
                                           data-storefront-purchase-attribute-name="@option.Name"
                                           class="@Classes.ColorOptionInput" />
                                    <span class="@(HasValidColor(value) ? Classes.ValidColorSwatch : Classes.MissingColorSwatch)" style="@ColorSwatchStyle(value)"></span>
                                    <span>@value.Value</span>
                                </label>
                            }
                        </div>
                    }
                    else
                    {
                        <select id="@OptionInputId(option)"
                                class="@Classes.Select"
                                data-storefront-purchase-attribute
                                data-storefront-purchase-attribute-name="@option.Name">
                            @if (!option.IsRequired)
                            {
                                <option value="">@string.Format(Labels.SelectOptionFormat, option.Name)</option>
                            }

                            @foreach (var value in ActiveVariationValues(option))
                            {
                                <option value="@value.Value" selected="@value.IsSelected">@value.Value</option>
                            }
                        </select>
                    }
                </fieldset>
            }
        </div>
    }
    else if (Model.Variants.Count > 0)
    {
        <div class="@Classes.OptionGroup">
            <label for="@Actions.VariantSelectId" class="@Classes.QuantityLabel">@Labels.ChooseVariant</label>
            <select id="@Actions.VariantSelectId" class="@Classes.Select" data-storefront-purchase-variant>
                <option value="">@Labels.SelectVariant</option>
                @foreach (var variant in Model.Variants)
                {
                    <option value="@variant.Id" selected="@variant.IsDefault" data-size-value="@variant.SizeValue" data-display-name="@variant.DisplayName">@variant.OptionLabel</option>
                }
            </select>
        </div>
    }

    <div class="@Classes.Quantity">
        <label for="@Actions.QuantityInputId" class="@Classes.QuantityLabel">@Labels.Quantity</label>
        <input id="@Actions.QuantityInputId" type="number" min="@Model.MinOrderQuantity" max="@Model.MaxOrderQuantity" step="@Model.QuantityStep" value="@Model.MinOrderQuantity" class="@Classes.QuantityInput" data-storefront-purchase-quantity />
    </div>

    <div class="@Classes.Actions">
        <button type="button" class="@(Model.CanSubmitInitialPurchase ? Classes.AddButton : Classes.DisabledAddButton)" data-storefront-command="cart.add-line" data-storefront-product-purchase-submit data-default-label="@Labels.AddToCart" data-success-label="@Labels.AddedToCart" data-resolved-variant-id="@Model.ResolvedVariantId" data-storefront-purchase-variant-selector="@(Snapshot.UsesVariantSelect ? Actions.VariantSelectSelector : null)" disabled="@(!Model.CanSubmitInitialPurchase)" data-feedback-target="@Actions.FeedbackTargetSelector">@Labels.AddToCart</button>
        <a href="@Model.CartUrl" class="@Classes.CartLink">@Labels.ViewCart</a>
    </div>

    <p id="@Actions.FeedbackElementId" class="@Classes.Feedback" aria-live="polite" data-storefront-purchase-feedback data-level="success">@Snapshot.InitialSelectionMessage</p>
</div>

@code {
    [Parameter, EditorRequired] public ProductPurchasePanelModel Model { get; set; } = default!;
    [Parameter, EditorRequired] public ProductPurchaseActionDescriptor Actions { get; set; } = default!;
    [Parameter, EditorRequired] public ProductPurchaseLabels Labels { get; set; } = default!;
    [Parameter, EditorRequired] public ProductPurchasePanelClasses Classes { get; set; } = default!;

    private ProductPurchaseSnapshot Snapshot => ProductPurchaseSnapshot.Create(Model, Actions);

    private static IReadOnlyList<ProductPurchaseOptionValueItem> ActiveVariationValues(ProductPurchaseOptionItem option) => option.Values.Where(value => !string.IsNullOrWhiteSpace(value.Value)).ToArray();
    private static bool IsRadioControl(ProductPurchaseOptionItem option) => string.Equals(option.ControlType, "radio", StringComparison.OrdinalIgnoreCase);
    private static bool IsColorControl(ProductPurchaseOptionItem option) => string.Equals(option.ControlType, "color", StringComparison.OrdinalIgnoreCase);
    private static string OptionInputId(ProductPurchaseOptionItem option) => $"product-option-{SanitizeDomToken(option.Name)}";
    private static string OptionInputName(ProductPurchaseOptionItem option) => $"product_option_{SanitizeDomToken(option.Name)}";
    private static string OptionValueInputId(ProductPurchaseOptionItem option, ProductPurchaseOptionValueItem value) => $"{OptionInputId(option)}-{SanitizeDomToken(value.Value)}";
    private static bool HasValidColor(ProductPurchaseOptionValueItem value) => value.ColorHex is { } color && global::System.Text.RegularExpressions.Regex.IsMatch(color, "^#[0-9a-fA-F]{3,8}$", global::System.Text.RegularExpressions.RegexOptions.CultureInvariant);
    private static string? ColorSwatchStyle(ProductPurchaseOptionValueItem value) => HasValidColor(value) ? $"background-color: {value.ColorHex};" : null;
    private static string SanitizeDomToken(string? value) { var raw = string.IsNullOrWhiteSpace(value) ? "option" : value.Trim().ToLowerInvariant(); var chars = raw.Select(character => char.IsLetterOrDigit(character) ? character : '-').ToArray(); var token = new string(chars).Trim('-'); return string.IsNullOrWhiteSpace(token) ? "option" : token; }
}

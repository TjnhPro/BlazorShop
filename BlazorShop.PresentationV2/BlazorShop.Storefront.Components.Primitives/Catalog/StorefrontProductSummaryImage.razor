@if (!string.IsNullOrWhiteSpace(Item.ImageUrl))
{
    <img class="@Classes.Image"
         src="@Item.ImageUrl"
         alt="@Item.Name"
         loading="lazy"
         onerror="@BrokenImageFallbackScript" />
    <div class="@Classes.ImageFallback"
         role="img"
         aria-label="@Labels.FormatImageUnavailableAlt(Item.Name)"
         hidden>
        @Labels.ImageUnavailableText
    </div>
}
else
{
    <div class="@Classes.ImageFallback"
         role="img"
         aria-label="@Labels.FormatImageUnavailableAlt(Item.Name)">
        @Labels.ImageUnavailableText
    </div>
}

@code {
    [Parameter, EditorRequired]
    public ProductSummaryItem Item { get; set; } = default!;

    [Parameter, EditorRequired]
    public ProductSummaryLabels Labels { get; set; } = ProductSummaryLabels.Empty;

    [Parameter, EditorRequired]
    public ProductSummaryCardClasses Classes { get; set; } = new();

    private const string BrokenImageFallbackScript = "this.onerror=null;this.hidden=true;this.src='data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 width=%221%22 height=%221%22/%3E';if(this.nextElementSibling){this.nextElementSibling.hidden=false;}";

    protected override void OnParametersSet()
    {
        ArgumentNullException.ThrowIfNull(Item);
        ArgumentNullException.ThrowIfNull(Labels);
        ArgumentNullException.ThrowIfNull(Classes);
    }
}

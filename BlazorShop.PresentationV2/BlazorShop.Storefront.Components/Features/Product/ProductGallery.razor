@namespace BlazorShop.Storefront.Components.Features.Product
@using BlazorShop.Storefront.Components.Contracts.Product
@using BlazorShop.Storefront.Components.Headless.Product

@if (Gallery.HasItems && Gallery.SelectedItem is { } main)
{
    <div data-storefront-product-gallery>
        <div data-storefront-gallery-main>
            <img src="@main.ImageUrl"
                 alt="@Gallery.SelectedAltText"
                 loading="eager"
                 data-storefront-gallery-main-image />
            <div
                 role="img"
                 aria-label="@Labels.FormatImageUnavailableAlt(Gallery.DisplayProductName)"
                 data-storefront-gallery-placeholder
                 hidden>
                @Labels.ImageUnavailableText
            </div>

            @if (Gallery.HasMultipleItems)
            {
                <div data-storefront-gallery-controls>
                    <button type="button"
                            aria-label="@Labels.PreviousImage"
                            aria-disabled="@(!Gallery.CanSelectPrevious).ToString().ToLowerInvariant()"
                            data-storefront-gallery-prev
                            disabled>
                        @Labels.PreviousImage
                    </button>
                    <button type="button"
                            aria-label="@Labels.NextImage"
                            aria-disabled="@(!Gallery.CanSelectNext).ToString().ToLowerInvariant()"
                            data-storefront-gallery-next>
                        @Labels.NextImage
                    </button>
                </div>
            }
        </div>

        @if (Gallery.HasMultipleItems)
        {
            <div data-storefront-gallery-thumb-viewport
                 role="list"
                 aria-label="@Labels.ImagesRegion">
                @for (var index = 0; index < Gallery.Items.Count; index++)
                {
                    var item = Gallery.Items[index];
                    <button type="button"
                            aria-label="@Labels.FormatImageButton(index + 1)"
                            aria-current="@(index == Gallery.SelectedIndex ? "true" : "false")"
                            aria-selected="@(index == Gallery.SelectedIndex ? "true" : "false")"
                            data-selected="@(index == Gallery.SelectedIndex ? "true" : "false")"
                            data-storefront-gallery-thumbnail
                            data-gallery-index="@index"
                            data-image-url="@item.ImageUrl"
                            data-alt="@item.AltText">
                        <img src="@item.ThumbnailUrl"
                             alt=""
                             loading="lazy" />
                        <span data-storefront-gallery-thumb-fallback
                              hidden>
                            @Labels.ImageUnavailableText
                        </span>
                    </button>
                }
            </div>
        }
    </div>
}
else
{
    <div data-storefront-product-gallery>
        <div
             role="img"
             aria-label="@Labels.FormatImageUnavailableAlt(Gallery.DisplayProductName)"
             data-storefront-gallery-placeholder>
            @Labels.ImageUnavailableText
        </div>
    </div>
}

@code {
    [Parameter]
    public IReadOnlyList<ProductGalleryItem> Items { get; set; } = [];

    [Parameter]
    public string? ProductName { get; set; }

    [Parameter]
    public ProductGalleryLabels Labels { get; set; } = ProductGalleryLabels.Empty;

    private ProductGalleryState Gallery => ProductGalleryState.Create(Items, ProductName);
}

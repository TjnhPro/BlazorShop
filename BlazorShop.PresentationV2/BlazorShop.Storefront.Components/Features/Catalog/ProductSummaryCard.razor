@namespace BlazorShop.Storefront.Components.Features.Catalog
@using BlazorShop.Storefront.Components.Contracts.Catalog

<article data-storefront-product-summary-card>
    <header>
        @if (!string.IsNullOrWhiteSpace(Item.CategoryName))
        {
            if (!string.IsNullOrWhiteSpace(Item.CategoryUrl))
            {
                <a href="@Item.CategoryUrl">@Item.CategoryName</a>
            }
            else
            {
                <span>@Item.CategoryName</span>
            }
        }

        @if (!string.IsNullOrWhiteSpace(Item.ProductUrl))
        {
            <a href="@Item.ProductUrl">
                <h2>@Item.Name</h2>
            </a>
        }
        else
        {
            <h2>@Item.Name</h2>
        }
    </header>

    <p>
        <span>@(Item.HasVariants ? Labels.FromPrefix : Labels.PricePrefix)</span>
        <span>@Item.PriceDisplay</span>
        @if (!string.IsNullOrWhiteSpace(Item.ComparePriceDisplay))
        {
            <s>@Item.ComparePriceDisplay</s>
        }
    </p>

    @if (!string.IsNullOrWhiteSpace(Item.ImageUrl))
    {
        <img src="@Item.ImageUrl" alt="@Item.Name" />
    }
    else
    {
        <div role="img" aria-label="@Labels.FormatImageUnavailableAlt(Item.Name)">@Labels.ImageUnavailableText</div>
    }

    @if (!string.IsNullOrWhiteSpace(Item.Description))
    {
        <p>@Item.Description</p>
    }

    <footer>
        @if (Item.IsNewArrival)
        {
            <span data-storefront-product-badge="new">@Labels.NewBadge</span>
        }
        @if (Item.HasVariants)
        {
            <span data-storefront-product-badge="variants">@Labels.VariantsBadge</span>
        }
        @if (!Item.InStock)
        {
            <span data-storefront-product-badge="out-of-stock">@Labels.OutOfStockBadge</span>
        }

        @if (Item.CanAddDirectly)
        {
            <button type="button"
                    data-storefront-add-to-cart
                    data-default-label="@Labels.AddToCart"
                    data-success-label="@Labels.AddedToCart"
                    data-product-id="@Item.Id"
                    data-product-name="@Item.Name"
                    data-unit-price="@Item.UnitPriceValue"
                    data-currency-code="@Item.CurrencyCode"
                    data-stock="@Item.DirectAddStockValue">
                @Labels.AddToCart
            </button>
        }
        else if (Item.HasVariants && !string.IsNullOrWhiteSpace(Item.PurchaseUrl))
        {
            <a href="@Item.PurchaseUrl">@Labels.AddToCart</a>
        }

        @if (!string.IsNullOrWhiteSpace(Item.ProductUrl))
        {
            <a href="@Item.ProductUrl">@Labels.ViewProduct</a>
        }
    </footer>
</article>

@code {
    [Parameter, EditorRequired]
    public ProductSummaryItem Item { get; set; } = default!;

    [Parameter]
    public ProductSummaryLabels Labels { get; set; } = ProductSummaryLabels.Empty;
}

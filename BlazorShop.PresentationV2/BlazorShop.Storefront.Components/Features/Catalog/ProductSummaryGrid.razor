@namespace BlazorShop.Storefront.Components.Features.Catalog
@using BlazorShop.Storefront.Components.Contracts.Catalog

@if (Items.Count > 0)
{
    <ul data-storefront-product-summary-grid>
        @foreach (var item in Items)
        {
            <li @key="item.Id">
                <ProductSummaryCard Item="item" Labels="Labels" />
            </li>
        }
    </ul>
}
else
{
    <p data-storefront-product-summary-empty>
        @EmptyMessage
    </p>
}

@code {
    [Parameter]
    public IReadOnlyList<ProductSummaryItem> Items { get; set; } = [];

    [Parameter]
    public ProductSummaryLabels Labels { get; set; } = ProductSummaryLabels.Empty;

    [Parameter]
    public string EmptyMessage { get; set; } = string.Empty;
}

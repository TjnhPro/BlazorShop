@namespace BlazorShop.Storefront.Components.Features.Account
@using BlazorShop.Storefront.Components.Browser
@using BlazorShop.Storefront.Components.Headless.Account
@inject IServiceProvider Services

<div class="@Classes.Root" data-storefront-account-order-detail>
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="@Classes.ErrorAlert" role="alert">@_error</div>
    }
    else if (_order is not null)
    {
        <div class="@Classes.MetricsGrid">
            <div>
                <p class="@Classes.MetricLabel">Order status</p>
                <p class="@Classes.MetricValue">@_order.OrderStatus</p>
            </div>
            <div>
                <p class="@Classes.MetricLabel">Payment</p>
                <p class="@Classes.MetricValue">@_order.PaymentStatus</p>
            </div>
            <div>
                <p class="@Classes.MetricLabel">Total</p>
                <p class="@Classes.MetricValue">@_order.TotalDisplay</p>
            </div>
        </div>

        <div class="@Classes.AddressGrid">
            @RenderAddress("Shipping address", _order.ShippingAddress)
            @RenderAddress("Billing address", _order.BillingAddress ?? _order.ShippingAddress)
        </div>

        <section class="@Classes.ItemsSection">
            <h2 class="@Classes.SectionTitle">Items</h2>
            <div class="@Classes.ItemsList">
                @foreach (var line in _order.Lines)
                {
                    <div class="@Classes.LineRow">
                        <div>
                            <p class="@Classes.LineName">@line.ProductName</p>
                            @if (!string.IsNullOrWhiteSpace(line.Sku))
                            {
                                <p class="@Classes.LineSku">@line.Sku</p>
                            }
                        </div>
                        <p class="@Classes.LineText">Qty @line.Quantity</p>
                        <p class="@Classes.LineTotal">@line.LineTotalDisplay</p>
                    </div>
                }
            </div>
        </section>

        <section class="@Classes.TotalsSection">
            <h2 class="@Classes.SectionTitle">Totals</h2>
            <div class="@Classes.TotalsBody">
                <div class="@Classes.TotalRow"><span>Subtotal</span><span>@_order.Totals.SubtotalDisplay</span></div>
                <div class="@Classes.TotalRow"><span>Shipping</span><span>@_order.Totals.ShippingDisplay</span></div>
                <div class="@Classes.TotalRow"><span>Tax</span><span>@_order.Totals.TaxDisplay</span></div>
                <div class="@Classes.TotalRow"><span>Discount</span><span>@_order.Totals.DiscountDisplay</span></div>
                <div class="@Classes.GrandTotalRow"><span>Grand total</span><span>@_order.Totals.GrandTotalDisplay</span></div>
            </div>
        </section>
    }
</div>

@code {
    [Parameter]
    public StorefrontBrowserAccountOrderDetail? InitialOrder { get; set; }

    [Parameter]
    public string? OrderReference { get; set; }

    [Parameter]
    public bool ReceiptMode { get; set; }

    [Parameter]
    public string? InitialError { get; set; }

    [Parameter]
    public StorefrontFeatureDataMode DataMode { get; set; } = StorefrontFeatureDataMode.BrowserFetch;

    [Parameter]
    public StorefrontAccountOrderActionDescriptor Actions { get; set; } = StorefrontAccountOrderActionDescriptor.Empty;

    [Parameter]
    public StorefrontAccountOrderDetailClasses Classes { get; set; } = StorefrontAccountOrderDetailClasses.Empty;

    private StorefrontBrowserAccountOrderDetail? _order;
    private string? _error;

    protected override void OnParametersSet()
    {
        _order = InitialOrder;
        _error = InitialError;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender
            || !OperatingSystem.IsBrowser()
            || DataMode == StorefrontFeatureDataMode.InitialSnapshot
            || string.IsNullOrWhiteSpace(OrderReference))
        {
            return;
        }

        var apiClient = Services.GetService(typeof(StorefrontLocalApiClient)) as StorefrontLocalApiClient;
        if (apiClient is null)
        {
            return;
        }

        var route = ReceiptMode
            ? Actions.ReceiptRoute(OrderReference)
            : Actions.OrderDetailRoute(OrderReference);
        var result = await apiClient.GetAsync<StorefrontBrowserAccountOrderDetail>(route);
        if (result.Success && result.Data is not null)
        {
            _order = result.Data;
            _error = null;
            StateHasChanged();
        }
    }

    private RenderFragment RenderAddress(string title, StorefrontBrowserOrderAddress address) => builder =>
    {
        builder.OpenElement(0, "section");
        builder.AddAttribute(1, "class", Classes.AddressSection);
        builder.OpenElement(2, "h2");
        builder.AddAttribute(3, "class", Classes.AddressTitle);
        builder.AddContent(4, title);
        builder.CloseElement();
        builder.OpenElement(5, "div");
        builder.AddAttribute(6, "class", Classes.AddressBody);
        AddAddressLine(builder, 7, address.FullName, Classes.AddressStrongLine);
        AddAddressLine(builder, 10, address.Address1, null);
        AddAddressLine(builder, 13, address.Address2, null);
        AddAddressLine(builder, 16, string.Join(", ", new[] { address.City, address.PostalCode }.Where(part => !string.IsNullOrWhiteSpace(part))), null);
        AddAddressLine(builder, 19, address.CountryCode, null);
        builder.CloseElement();
        builder.CloseElement();
    };

    private static void AddAddressLine(RenderTreeBuilder builder, int sequence, string? value, string? cssClass)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        builder.OpenElement(sequence, "p");
        if (!string.IsNullOrWhiteSpace(cssClass))
        {
            builder.AddAttribute(sequence + 1, "class", cssClass);
        }

        builder.AddContent(sequence + 2, value);
        builder.CloseElement();
    }
}

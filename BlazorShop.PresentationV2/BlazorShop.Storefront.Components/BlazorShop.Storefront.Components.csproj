<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BlazorShop.Storefront.Components</RootNamespace>
    <PackageId>BlazorShop.Storefront.Components</PackageId>
    <Version>1.0.0</Version>
    <Authors>BlazorShop</Authors>
    <Description>Browser-safe Storefront contracts, headless interaction state, and browser primitives.</Description>
    <RepositoryUrl>https://github.com/TjnhPro/BlazorShop</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>

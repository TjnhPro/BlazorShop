@namespace BlazorShop.Storefront.Presentation.Components.Auth

<form method="post" action="@Context.PostAction" class="@FormClass" data-storefront-signin-form>
    <AntiforgeryToken />
    <input type="hidden" name="@StorefrontAuthFormFieldNames.SignIn.ReturnUrl" value="@Context.SafeReturnUrl" />
    <input type="hidden" name="@StorefrontAuthFormFieldNames.SignIn.CaptchaToken" data-storefront-captcha-token="@CaptchaPurpose" />

    <label class="@LabelClass">
        <span class="@LabelTextClass">@EmailLabel</span>
        <input name="@StorefrontAuthFormFieldNames.SignIn.Email" type="email" autocomplete="email" required class="@InputClass" />
    </label>

    <label class="@LabelClass">
        <span class="@LabelTextClass">@PasswordLabel</span>
        <input name="@StorefrontAuthFormFieldNames.SignIn.Password" type="password" autocomplete="current-password" required class="@InputClass" />
    </label>

    @AdditionalContent

    <button type="submit" class="@SubmitClass">
        @SubmitContent
    </button>
</form>

@code {
    [Parameter, EditorRequired]
    public StorefrontAuthPageContext Context { get; set; } = default!;

    [Parameter]
    public string FormClass { get; set; } = string.Empty;

    [Parameter]
    public string LabelClass { get; set; } = string.Empty;

    [Parameter]
    public string LabelTextClass { get; set; } = string.Empty;

    [Parameter]
    public string InputClass { get; set; } = string.Empty;

    [Parameter]
    public string SubmitClass { get; set; } = string.Empty;

    [Parameter]
    public string EmailLabel { get; set; } = "Email address";

    [Parameter]
    public string PasswordLabel { get; set; } = "Password";

    [Parameter]
    public string CaptchaPurpose { get; set; } = "login";

    [Parameter]
    public RenderFragment? AdditionalContent { get; set; }

    [Parameter]
    public RenderFragment SubmitContent { get; set; } = builder => builder.AddContent(0, "Sign in");
}

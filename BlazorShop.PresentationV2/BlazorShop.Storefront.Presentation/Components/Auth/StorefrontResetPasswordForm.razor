@namespace BlazorShop.Storefront.Presentation.Components.Auth

@if (Context.MissingRecoveryData)
{
    @MissingRecoveryContent
}
else
{
    <form method="post" action="@Context.PostAction" class="@FormClass" data-storefront-reset-password-form>
        <AntiforgeryToken />
        <input type="hidden" name="@StorefrontAuthFormFieldNames.ResetPassword.Email" value="@Context.Email" />
        <input type="hidden" name="@StorefrontAuthFormFieldNames.ResetPassword.Token" value="@Context.Token" />

        <label class="@LabelClass">
            <span class="@LabelTextClass">@EmailLabel</span>
            <input type="email" value="@Context.Email" disabled class="@DisabledInputClass" />
        </label>

        <label class="@LabelClass">
            <span class="@LabelTextClass">@PasswordLabel</span>
            <input name="@StorefrontAuthFormFieldNames.ResetPassword.Password" type="password" autocomplete="new-password" required minlength="@PasswordMinLength" class="@InputClass" />
        </label>

        <label class="@LabelClass">
            <span class="@LabelTextClass">@ConfirmPasswordLabel</span>
            <input name="@StorefrontAuthFormFieldNames.ResetPassword.ConfirmPassword" type="password" autocomplete="new-password" required minlength="@PasswordMinLength" class="@InputClass" />
        </label>

        @AdditionalContent

        <button type="submit" class="@SubmitClass">
            @SubmitContent
        </button>
    </form>
}

@code {
    [Parameter, EditorRequired]
    public StorefrontAuthPageContext Context { get; set; } = default!;

    [Parameter]
    public string FormClass { get; set; } = string.Empty;

    [Parameter]
    public string LabelClass { get; set; } = string.Empty;

    [Parameter]
    public string LabelTextClass { get; set; } = string.Empty;

    [Parameter]
    public string InputClass { get; set; } = string.Empty;

    [Parameter]
    public string DisabledInputClass { get; set; } = string.Empty;

    [Parameter]
    public string SubmitClass { get; set; } = string.Empty;

    [Parameter]
    public string EmailLabel { get; set; } = "Email address";

    [Parameter]
    public string PasswordLabel { get; set; } = "New password";

    [Parameter]
    public string ConfirmPasswordLabel { get; set; } = "Confirm new password";

    [Parameter]
    public int PasswordMinLength { get; set; } = 8;

    [Parameter]
    public RenderFragment? AdditionalContent { get; set; }

    [Parameter]
    public RenderFragment? MissingRecoveryContent { get; set; }

    [Parameter]
    public RenderFragment SubmitContent { get; set; } = builder => builder.AddContent(0, "Reset password");
}

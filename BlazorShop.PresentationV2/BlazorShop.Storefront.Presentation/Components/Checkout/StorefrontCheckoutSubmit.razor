@namespace BlazorShop.Storefront.Presentation.Components.Checkout

<button type="submit" class="@Class" data-storefront-checkout-submit>
    @ChildContent
</button>

@code {
    [Parameter]
    public string Class { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment ChildContent { get; set; } = builder => builder.AddContent(0, "Place order");
}

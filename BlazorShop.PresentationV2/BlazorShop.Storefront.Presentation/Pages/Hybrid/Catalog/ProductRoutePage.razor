@page "/product/{Slug}"
@namespace BlazorShop.Storefront.Presentation.Pages.Hybrid.Catalog
@using BlazorShop.Storefront.Presentation.PagePatterns
@using BlazorShop.Storefront.Presentation.Services.Product
@using BlazorShop.Storefront.Presentation.Views.Foundation
@using BlazorShop.Storefront.Services
@inject StorefrontProductPageService ProductPageService
@inject StorefrontFoundationViewSet ViewSet

<StorefrontPage TContext="StorefrontProductPageContext"
    CurrentState="_result.State"
    Metadata="_result.Metadata"
    StructuredData="_result.StructuredData">
    <Body>
        @if (_result.State is StorefrontPageState.Ready<StorefrontProductPageContext> ready)
        {
            <StorefrontFoundationViewOutlet ComponentType="@ViewSet.ProductPage" Context="ready.Context" />
        }
    </Body>
    <NotFoundContent>
        <StorefrontFoundationViewOutlet ComponentType="@ViewSet.NotFoundState" />
    </NotFoundContent>
    <ServiceUnavailableContent>
        <StorefrontFoundationViewOutlet ComponentType="@ViewSet.ServiceUnavailableState" />
    </ServiceUnavailableContent>
</StorefrontPage>

@code {
    private StorefrontProductPageResult _result = StorefrontProductPageResult.Empty;

    [Parameter]
    public string Slug { get; set; } = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        _result = await ProductPageService.ResolveAsync(Slug);
    }
}

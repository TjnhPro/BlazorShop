@page "/new-releases"
@inject StorefrontNewReleasesPageService NewReleasesPageService
@inject IOptions<StorefrontFoundationViewOptions> FoundationOptions

<StorefrontSeoHead Metadata="_result.Metadata" StructuredData="_result.StructuredData" />

@if (_result.State is StorefrontPageState.ServiceUnavailableState)
{
    <StorefrontFoundationViewOutlet ComponentType="@ViewSet.ServiceUnavailableState" />
}
else if (_result.Context is not null)
{
    <StorefrontFoundationViewOutlet ComponentType="@ViewSet.NewReleasesPage" Context="_result.Context" />
}

@code {
    private StorefrontCatalogPageResult<StorefrontCatalogProductsPageContext> _result = StorefrontCatalogPageResult<StorefrontCatalogProductsPageContext>.Empty;

    private StorefrontFoundationViewSet ViewSet => FoundationOptions.Value.ViewSet
        ?? throw new InvalidOperationException("A StorefrontFoundationViewSet must be registered.");

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _result = await NewReleasesPageService.GetAsync();
        StorefrontResponseHeaders.ApplyStatus(HttpContext, _result.State);
    }
}

@page "/"
@inject StorefrontHomePageService HomePageService
@inject IOptions<StorefrontFoundationViewOptions> FoundationOptions

<StorefrontPage TContext="StorefrontHomePageContext"
    CurrentState="_result.State"
    Metadata="_result.Metadata"
    StructuredData="_result.StructuredData">
    <Body>
        <StorefrontFoundationViewOutlet ComponentType="@ViewSet.HomePage" Context="_result.Context" />
    </Body>
    <ServiceUnavailableContent>
        <StorefrontFoundationViewOutlet ComponentType="@ViewSet.ServiceUnavailableState" />
    </ServiceUnavailableContent>
</StorefrontPage>

@code {
    private StorefrontCatalogPageResult<StorefrontHomePageContext> _result = StorefrontCatalogPageResult<StorefrontHomePageContext>.Empty;

    private StorefrontFoundationViewSet ViewSet => FoundationOptions.Value.ViewSet
        ?? throw new InvalidOperationException("A StorefrontFoundationViewSet must be registered.");

    protected override async Task OnParametersSetAsync()
    {
        _result = await HomePageService.GetAsync();
    }
}

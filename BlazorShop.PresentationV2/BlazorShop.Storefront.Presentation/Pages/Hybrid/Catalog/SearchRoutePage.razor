@page "/search"
@inject StorefrontSearchPageService SearchPageService
@inject IOptions<StorefrontFoundationViewOptions> FoundationOptions

<StorefrontPage TContext="StorefrontSearchPageContext"
    CurrentState="_result.State"
    Metadata="_result.Metadata"
    StructuredData="_result.StructuredData">
    <Body>
        <StorefrontFoundationViewOutlet ComponentType="@ViewSet.SearchPage" Context="_result.Context" />
    </Body>
    <ServiceUnavailableContent>
        <StorefrontFoundationViewOutlet ComponentType="@ViewSet.ServiceUnavailableState" />
    </ServiceUnavailableContent>
</StorefrontPage>

@code {
    private StorefrontCatalogPageResult<StorefrontSearchPageContext> _result = StorefrontCatalogPageResult<StorefrontSearchPageContext>.Empty;

    private StorefrontFoundationViewSet ViewSet => FoundationOptions.Value.ViewSet
        ?? throw new InvalidOperationException("A StorefrontFoundationViewSet must be registered.");

    [SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    [SupplyParameterFromQuery(Name = "category")]
    public string? Category { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;

    [SupplyParameterFromQuery(Name = "pageSize")]
    public int PageSize { get; set; } = 24;

    [SupplyParameterFromQuery(Name = "minPrice")]
    public decimal? MinPrice { get; set; }

    [SupplyParameterFromQuery(Name = "maxPrice")]
    public decimal? MaxPrice { get; set; }

    [SupplyParameterFromQuery(Name = "inStock")]
    public bool InStock { get; set; }

    [SupplyParameterFromQuery(Name = "sortBy")]
    public string? SortByQuery { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _result = await SearchPageService.GetAsync(Q, Category, MinPrice, MaxPrice, InStock, Page, PageSize, SortByQuery);
    }
}

@page "/checkout"
@namespace BlazorShop.Storefront.Presentation.Pages.Hybrid.Commerce
@using BlazorShop.Storefront.Presentation.Services.Checkout
@using BlazorShop.Storefront.Presentation.Views.Foundation
@inject StorefrontCheckoutPageService PageService
@inject StorefrontFoundationViewSet ViewSet

<StorefrontPage TContext="StorefrontCheckoutPageContext" CurrentState="_state">
    <Body>
        <StorefrontFoundationViewOutlet ComponentType="@ViewSet.CheckoutPage" Context="_context" />
    </Body>
</StorefrontPage>

@code {
    private StorefrontCheckoutPageContext? _context;
    private StorefrontPageState _state = new StorefrontPageState.LoadingState();

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "orderReference")]
    public string? OrderReference { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _context = await PageService.GetAsync(HttpContext, Error, OrderReference);
        _state = new StorefrontPageState.Ready<StorefrontCheckoutPageContext>(
            StorefrontPageKind.Checkout,
            _context,
            new StorefrontPageDocument("Checkout", RobotsIndex: false, RobotsFollow: false));
    }
}

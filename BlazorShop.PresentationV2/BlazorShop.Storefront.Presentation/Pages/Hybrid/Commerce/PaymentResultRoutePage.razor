@page "/payment-success"
@page "/payment-cancel"
@page "/payment/result"
@namespace BlazorShop.Storefront.Presentation.Pages.Hybrid.Commerce
@using BlazorShop.Storefront.Presentation.Services.Checkout
@using BlazorShop.Storefront.Presentation.Views.Foundation
@inject StorefrontPaymentResultPageService PageService
@inject StorefrontFoundationViewSet ViewSet

<PageTitle>Payment status</PageTitle>

<HeadContent>
    <meta name="robots" content="noindex,nofollow" />
</HeadContent>

@if (_context is not null)
{
    <StorefrontFoundationViewOutlet ComponentType="@ViewSet.PaymentResultPage" Context="_context" />
}

@code {
    private StorefrontPaymentResultPageContext? _context;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromQuery(Name = "paymentAttemptId")]
    public Guid? PaymentAttemptId { get; set; }

    [SupplyParameterFromQuery(Name = "provider")]
    public string? Provider { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        StorefrontResponseHeaders.ApplyPrivatePage(HttpContext);
        var path = HttpContext?.Request.Path.Value ?? string.Empty;
        var isCancelRoute = path.StartsWith("/payment-cancel", StringComparison.OrdinalIgnoreCase);
        _context = await PageService.GetAsync(isCancelRoute, PaymentAttemptId, Provider);
    }
}

@page "/account"
@page "/account/{*Path}"
@namespace BlazorShop.Storefront.Presentation.Pages.WasmHost.Account
@using BlazorShop.Storefront.Presentation.Services.Account
@using BlazorShop.Storefront.Presentation.Views.Foundation
@inject StorefrontAccountPageService PageService
@inject StorefrontFoundationViewSet ViewSet
@inject NavigationManager NavigationManager

@if (_redirectIssued)
{
    <section data-storefront-account-redirect hidden aria-hidden="true"></section>
}
else
{
    <StorefrontPage TContext="StorefrontAccountPageContext" CurrentState="_state">
        <Body>
            @if (_result is StorefrontAccountPageResult.ReadyState ready)
            {
                <StorefrontFoundationViewOutlet ComponentType="@ViewSet.AccountPage" Context="ready.Context" />
            }
        </Body>
        <UnauthorizedContent>
            <section data-storefront-account-redirect hidden aria-hidden="true"></section>
        </UnauthorizedContent>
    </StorefrontPage>
}

@code {
    private StorefrontAccountPageResult? _result;
    private bool _redirectIssued;
    private StorefrontPageState _state = new StorefrontPageState.LoadingState();

    [Parameter]
    public string? Path { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "saved")]
    public string? Saved { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int Page { get; set; } = 1;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _result = await PageService.GetAsync(HttpContext, Path, Page, Error, Saved);
        if (_result is StorefrontAccountPageResult.RedirectState redirect)
        {
            _redirectIssued = true;
            _state = new StorefrontPageState.LoadingState();
            if (HttpContext is not null && !HttpContext.Response.HasStarted)
            {
                HttpContext.Response.Redirect(redirect.Url);
            }
            else
            {
                NavigationManager.NavigateTo(redirect.Url, replace: true);
            }

            return;
        }

        if (_result is StorefrontAccountPageResult.ReadyState ready)
        {
            _state = new StorefrontPageState.Ready<StorefrontAccountPageContext>(
                StorefrontPageKind.Account,
                ready.Context,
                new StorefrontPageDocument("Account", RobotsIndex: false, RobotsFollow: false));
        }
    }
}

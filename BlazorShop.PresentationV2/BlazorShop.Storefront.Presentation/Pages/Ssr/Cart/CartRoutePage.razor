@page "/my-cart"
@page "/cart"
@namespace BlazorShop.Storefront.Presentation.Pages.Ssr.Cart
@inject StorefrontCartPageService CartPageService
@inject StorefrontFoundationViewSet ViewSet

<StorefrontPage TContext="StorefrontCartPageContext" CurrentState="_state">
    <Body>
        <StorefrontFoundationViewOutlet ComponentType="@ViewSet.CartPage" Context="_context" />
    </Body>
</StorefrontPage>

@code {
    private StorefrontCartPageContext? _context;
    private StorefrontPageState _state = new StorefrontPageState.LoadingState();

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        _context = await CartPageService.GetAsync(HttpContext);
        _state = new StorefrontPageState.Ready<StorefrontCartPageContext>(
            StorefrontPageKind.Cart,
            _context,
            new StorefrontPageDocument("My Cart", RobotsIndex: false, RobotsFollow: false));
    }
}

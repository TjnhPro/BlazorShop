@page "/maintenance"
@namespace BlazorShop.Storefront.Presentation.Pages.Ssr.System
@using BlazorShop.Storefront.Presentation.Services.System
@using BlazorShop.Storefront.Presentation.Views.Foundation
@using BlazorShop.Storefront.Services.Contracts
@inject IStorefrontCurrentStoreProvider CurrentStoreProvider
@inject NavigationManager NavigationManager
@inject StorefrontFoundationViewSet ViewSet

@if (!_redirecting)
{
    <StorefrontPage TContext="StorefrontSystemStateContext" CurrentState="_state" Metadata="_metadata" AutoRefreshSeconds="_autoRefreshSeconds">
        <Body>
            <StorefrontFoundationViewOutlet ComponentType="@ViewSet.MaintenanceState" Context="_context" />
        </Body>
        <MaintenanceContent>
            <StorefrontFoundationViewOutlet ComponentType="@ViewSet.MaintenanceState" Context="_context" />
        </MaintenanceContent>
        <ServiceUnavailableContent>
            <StorefrontFoundationViewOutlet ComponentType="@ViewSet.ServiceUnavailableState" Context="_context" />
        </ServiceUnavailableContent>
    </StorefrontPage>
}

@code {
    [SupplyParameterFromQuery(Name = "reason")]
    public string? Reason { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private StorefrontSystemStateContext _context = new(
        "Store temporarily unavailable",
        "Store unavailable",
        "This storefront is not ready to serve shoppers right now.");
    private StorefrontPageState _state = new StorefrontPageState.MaintenanceState("Store temporarily unavailable.");
    private SeoMetadataDto _metadata = PrivateMetadata("Store temporarily unavailable");
    private int? _autoRefreshSeconds;
    private bool _redirecting;

    protected override async Task OnParametersSetAsync()
    {
        var resolution = await CurrentStoreProvider.ResolveAsync();

        if (resolution.Status == StorefrontCurrentStoreResolutionStatus.Success)
        {
            _redirecting = true;
            RedirectToHome();
            return;
        }

        _redirecting = false;

        var reason = string.IsNullOrWhiteSpace(Reason)
            ? ToReason(resolution.Status)
            : Reason.Trim().ToLowerInvariant();

        _context = new StorefrontSystemStateContext(
            ResolveTitle(reason),
            ResolveEyebrow(reason),
            ResolveMessage(reason, resolution),
            resolution.Store,
            reason,
            string.Equals(reason, "maintenance", StringComparison.OrdinalIgnoreCase));
        _state = string.Equals(reason, "maintenance", StringComparison.OrdinalIgnoreCase)
            ? new StorefrontPageState.MaintenanceState(_context.Message)
            : new StorefrontPageState.ServiceUnavailableState(StorefrontPageKind.ServiceUnavailable, _context.Message);
        _metadata = PrivateMetadata(_context.Title);
        _autoRefreshSeconds = _context.AutoRefresh ? 10 : null;
    }

    private void RedirectToHome()
    {
        if (HttpContext is not null && !HttpContext.Response.HasStarted)
        {
            HttpContext.Response.Redirect(StorefrontRoutes.Home, permanent: false);
            return;
        }

        NavigationManager.NavigateTo(StorefrontRoutes.Home, replace: true);
    }

    private static string ToReason(StorefrontCurrentStoreResolutionStatus status)
    {
        return status switch
        {
            StorefrontCurrentStoreResolutionStatus.Maintenance => "maintenance",
            StorefrontCurrentStoreResolutionStatus.Closed => "closed",
            StorefrontCurrentStoreResolutionStatus.NotReady => "not-ready",
            StorefrontCurrentStoreResolutionStatus.NotFound => "not-found",
            _ => "unavailable",
        };
    }

    private static string ResolveTitle(string reason)
    {
        return reason switch
        {
            "maintenance" => "Store maintenance in progress",
            "closed" => "Store is currently closed",
            "not-ready" => "Store is not ready yet",
            "not-found" => "Store was not found",
            _ => "Store temporarily unavailable",
        };
    }

    private static string ResolveEyebrow(string reason)
    {
        return reason switch
        {
            "maintenance" => "Maintenance",
            "closed" => "Closed",
            "not-ready" => "Provisioning",
            "not-found" => "Not found",
            _ => "Unavailable",
        };
    }

    private static string ResolveMessage(string reason, StorefrontCurrentStoreResolution resolution)
    {
        if (reason == "maintenance" && !string.IsNullOrWhiteSpace(resolution.Message))
        {
            return resolution.Message;
        }

        return reason switch
        {
            "closed" => "This store is inactive right now. Admins can still manage it from the Control Plane.",
            "not-ready" => "This store is still being prepared. Check back after provisioning finishes.",
            "not-found" => "The configured storefront store key or domain does not match an available store.",
            _ => "The storefront cannot serve shoppers right now.",
        };
    }

    private static SeoMetadataDto PrivateMetadata(string title)
    {
        return new SeoMetadataDto
        {
            Title = title,
            RobotsIndex = false,
            RobotsFollow = false,
        };
    }
}

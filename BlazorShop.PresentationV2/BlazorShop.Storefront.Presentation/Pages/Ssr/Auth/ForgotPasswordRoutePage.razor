@page "/forgot-password"
@namespace BlazorShop.Storefront.Presentation.Pages.Ssr.Auth
@using BlazorShop.Storefront.Presentation.Services.Auth
@using BlazorShop.Storefront.Presentation.Views.Foundation
@inject StorefrontAuthPageService AuthPageService
@inject StorefrontFoundationViewSet ViewSet

<StorefrontPage TContext="StorefrontAuthPageContext" CurrentState="_state">
    <Body>
        <StorefrontFoundationViewOutlet ComponentType="@ViewSet.AuthPage" Context="_result.Context" />
    </Body>
</StorefrontPage>

@code {
    private StorefrontAuthPageResult _result = new(null, null);
    private StorefrontPageState _state = new StorefrontPageState.LoadingState();

    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "sent")]
    public string? Sent { get; set; }

    protected override void OnParametersSet()
    {
        _result = AuthPageService.GetForgotPassword(Email, Error, Sent);
        if (_result.Context is not null)
        {
            _state = new StorefrontPageState.Ready<StorefrontAuthPageContext>(
                StorefrontPageKind.Auth,
                _result.Context,
                new StorefrontPageDocument("Forgot password", RobotsIndex: false, RobotsFollow: false));
        }
    }
}

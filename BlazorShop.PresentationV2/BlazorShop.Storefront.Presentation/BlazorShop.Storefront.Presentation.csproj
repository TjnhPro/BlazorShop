<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>BlazorShop.Storefront.Presentation</PackageId>
    <Version>1.0.0</Version>
    <Authors>BlazorShop</Authors>
    <Description>Storefront application presentation engine for host-owned visual implementations.</Description>
    <RepositoryUrl>https://github.com/TjnhPro/BlazorShop</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorShop.Storefront.Components\BlazorShop.Storefront.Components.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\BlazorShop.Storefront.Runtime\BlazorShop.Storefront.Runtime.csproj" PrivateAssets="all" />
  </ItemGroup>

</Project>

@using BlazorShop.Storefront.Presentation.Services.Cart

<h1>Cart</h1>
<PlaceholderState
    Title="Cart shell"
    Message="Cart browser commands call Presentation-owned same-origin BFF endpoints."
    RenderOwner="Hybrid"
    HydrationMode="StarterHydrationMode.InitialSnapshot" />
<CartLineList Lines="@CartLines" />

@code {
    [Parameter, EditorRequired]
    public StorefrontCartPageContext Context { get; set; } = default!;

    private IReadOnlyList<CartLineList.StarterCartLine> CartLines =>
        Context.Cart?.Lines
            .Select(line => new CartLineList.StarterCartLine(line.DisplayName, line.Quantity))
            .ToArray()
        ?? [];
}

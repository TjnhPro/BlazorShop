@using BlazorShop.Storefront.Presentation.Services.Checkout
@using BlazorShop.Storefront.Presentation.Components.Checkout

<h1>Checkout</h1>
<PlaceholderState
    Title="@Title"
    Message="@Message"
    RenderOwner="Hybrid"
    HydrationMode="StarterHydrationMode.InitialSnapshot" />
<CheckoutStepShell StepNumber="1" Title="Contact and shipping">
    @if (Context.Lines.Count > 0)
    {
        <p>@Context.Lines.Count item(s) ready for checkout.</p>
        @if (Context.PaymentMethods.Count > 0)
        {
            <StorefrontCheckoutForm Context="Context" FormClass="starter-form">
                <StorefrontCheckoutAddressFields Context="Context"
                                                ContactSectionClass="starter-form"
                                                AddressSectionClass="starter-form"
                                                AddressGridClass="starter-form"
                                                LabelClass="starter-field"
                                                AddressLineClass="starter-field"
                                                LabelTextClass="starter-label"
                                                InputClass="starter-input"
                                                UppercaseInputClass="starter-input"
                                                HeadingClass="starter-heading" />
                <StorefrontCheckoutPaymentFields Context="Context"
                                                SectionClass="starter-form"
                                                HeadingClass="starter-heading"
                                                OptionLabelClass="starter-field"
                                                RadioClass="starter-radio"
                                                OptionTitleClass="starter-label"
                                                OptionDescriptionClass="starter-help" />
                <StorefrontCheckoutSubmit Class="starter-button">Place order</StorefrontCheckoutSubmit>
            </StorefrontCheckoutForm>
        }
    }
</CheckoutStepShell>

@code {
    [Parameter, EditorRequired]
    public StorefrontCheckoutPageContext Context { get; set; } = default!;

    private string Title => Context.HasOrderReference
        ? "Order placed"
        : Context.Lines.Count == 0
            ? "Cart is empty"
            : "Checkout shell";

    private string Message => Context.HasOrderReference
        ? $"Order reference {Context.OrderReference}."
        : Context.CheckoutState.Message ?? "Checkout state and order placement stay backend-authoritative through BFF commands.";
}

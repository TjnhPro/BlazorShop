@namespace BlazorShop.Storefront.Starter.Pages.Catalog

<h1>Search</h1>
<PlaceholderState
    Title="Search shell"
    Message="Search can start from query SSR data and refresh after hydration when filters change."
    RenderOwner="Hybrid"
    HydrationMode="StarterHydrationMode.RefreshAfterHydration" />
@if (!string.IsNullOrWhiteSpace(Context.Q))
{
    <p>Results for @Context.Q</p>
}
<ProductGrid Products="@Context.ProductSummaries" />

@code {
    [Parameter, EditorRequired]
    public StorefrontSearchPageContext Context { get; set; } = default!;
}

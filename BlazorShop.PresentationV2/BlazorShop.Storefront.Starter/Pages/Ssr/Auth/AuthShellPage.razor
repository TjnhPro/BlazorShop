@namespace BlazorShop.Storefront.Starter.Theme.Pages.Auth
@using BlazorShop.Storefront.Presentation.Services.Auth

<h1>@Context.Title</h1>
@if (Context.ReturnUrlRejected)
{
    <section class="starter-alert" data-error-code="security.return_url">
        <h2>Invalid return URL</h2>
        <p>The requested return URL was rejected.</p>
    </section>
}
<PlaceholderState
    Title="Auth form shell"
    Message="Server-owned auth forms keep cookie and return-url decisions on the shared Presentation boundary."
    RenderOwner="SSR"
    HydrationMode="StarterHydrationMode.InitialSnapshot" />

@code {
    [Parameter, EditorRequired]
    public StorefrontAuthPageContext Context { get; set; } = default!;
}

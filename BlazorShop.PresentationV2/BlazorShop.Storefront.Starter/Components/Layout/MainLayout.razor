@using BlazorShop.Storefront.Presentation.Contracts
@inherits LayoutComponentBase

<header class="starter-header">
    <a class="starter-brand" href="@Context.Links.Home.Href">@Context.Header.Brand.Label</a>
    <nav aria-label="Main navigation">
        <a href="@Context.Links.Home.Href">@Context.Links.Home.Label</a>
        <a href="@Context.Links.Search.Href">@Context.Links.Search.Label</a>
        <a href="@Context.Links.Cart.Href" aria-label="Cart">@Context.Links.Cart.Label <span data-storefront-cart-badge hidden>0</span></a>
        <a href="@Context.Links.AccountRoot.Href" aria-label="Account">@Context.Links.AccountRoot.Label</a>
    </nav>
</header>

<main class="starter-main">
    <nav class="starter-breadcrumb" aria-label="Breadcrumb">
        <a href="@Context.Links.Home.Href">@Context.Links.Home.Label</a>
    </nav>
    @Body
</main>

<div class="starter-toast-region" aria-live="polite" aria-atomic="true"></div>

<footer class="starter-footer">
    <span>@Context.Footer.CopyrightLabel</span>
</footer>

@code {
    [Parameter, EditorRequired]
    public StorefrontShellContext Context { get; set; } = default!;
}

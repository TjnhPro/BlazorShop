@using BlazorShop.Storefront.Services.Contracts

<section class="starter-account-shell">
    <nav aria-label="Account navigation">
        <a href="@Links.AccountProfile.Href">@Links.AccountProfile.Label</a>
        <a href="@Links.AccountAddresses.Href">@Links.AccountAddresses.Label</a>
        <a href="@Links.AccountOrders.Href">@Links.AccountOrders.Label</a>
        <a href="@Links.AccountPassword.Href">@Links.AccountPassword.Label</a>
    </nav>
    <div>
        @if (ChildContent is null)
        {
            <EmptyState Title="Account" Message="Account feature content is browser-owned behind same-origin APIs." />
        }
        else
        {
            @ChildContent
        }
    </div>
</section>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public StorefrontLinkContext Links { get; set; } = StorefrontLinkContext.Default;
}

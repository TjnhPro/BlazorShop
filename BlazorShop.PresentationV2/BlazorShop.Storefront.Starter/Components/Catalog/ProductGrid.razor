@if (Products.Count == 0)
{
    <EmptyState Title="No products" Message="No products are available for this placement." />
}
else
{
    <div class="starter-product-grid">
        @foreach (var product in Products)
        {
            <ProductSummaryCard
                Name="@product.Name"
                ImageUrl="@product.ImageUrl"
                Price="@FormatPrice(product)"
                Href="@(product.ProductUrl ?? $"/product/{product.Id}")" />
        }
    </div>
}

@code {
    [Parameter]
    public IReadOnlyList<ProductSummaryItem> Products { get; set; } = [];

    private static string? FormatPrice(ProductSummaryItem product)
    {
        return string.IsNullOrWhiteSpace(product.PriceDisplay) ? null : product.PriceDisplay;
    }
}

<section class="@Classes.Root" data-storefront-component="contact-form" data-storefront-contact-shell>
    <StorefrontContactFormApp InitialState="State"
                              Labels="Labels"
                              Classes="Classes"
                              Action="Action"
                              @rendermode="InteractiveWebAssembly" />
</section>

@code {
    [Parameter]
    public StorefrontContactFormState State { get; set; } = StorefrontContactFormState.Empty;

    [Parameter]
    public StorefrontContactFormLabels Labels { get; set; } = EmptyLabels;

    [Parameter]
    public StorefrontContactFormClasses Classes { get; set; } = new();

    [Parameter]
    public StorefrontContactFormActionDescriptor Action { get; set; } = new(string.Empty);

    private static readonly StorefrontContactFormLabels EmptyLabels = new(
        string.Empty,
        string.Empty,
        string.Empty,
        string.Empty,
        string.Empty,
        string.Empty,
        string.Empty,
        string.Empty,
        string.Empty);
}

@namespace BlazorShop.Storefront.Components.WasmHost.Components.Cart
@inject IStorefrontBrowserCartController CartController

<section class="@Classes.PageSection">
    <div class="@Classes.Layout">
        <div class="@Classes.ContentColumn">
            <header class="@Classes.HeaderCard">
                <div class="@Classes.HeaderLayout">
                    <div>
                        <p class="@Classes.Eyebrow">@Labels.HeaderEyebrow</p>
                        <h1 class="@Classes.HeaderTitle">@Labels.Heading</h1>
                        <p class="@Classes.BodyText">@Labels.IntroductoryText</p>
                    </div>

                    <div class="@Classes.CountBadge">
                        @ViewState.ItemCount @(ViewState.ItemCount == 1 ? Labels.ItemCountSingular : Labels.ItemCountPlural) @Labels.ItemCountSuffix
                    </div>
                </div>
            </header>

            @foreach (var alert in Alerts)
            {
                <div class="@AlertClass(alert)">
                    @alert.Message
                </div>
            }

            @if (Lines.Count == 0)
            {
                <div class="@Classes.EmptyState">
                    <h2 class="@Classes.EmptyTitle">@Labels.EmptyHeading</h2>
                    <p class="@Classes.BodyText">@Labels.EmptyText</p>
                    <div class="@Classes.EmptyActions">
                        <a href="@ContinueShoppingUrl" class="@Classes.PrimaryLink">@Labels.BrowseProducts</a>
                        <a href="@SecondaryShoppingUrl" class="@Classes.SecondaryLink">@Labels.BackToHome</a>
                    </div>
                </div>
            }
            else
            {
                <div class="@Classes.LineList">
                    @foreach (var line in Lines)
                    {
                        <article class="@Classes.LineCard">
                            <div class="@Classes.LineLayout">
                                <div class="@Classes.LineImageFrame">
                                    @if (!string.IsNullOrWhiteSpace(line.ImageUrl))
                                    {
                                        <img src="@line.ImageUrl" alt="@line.DisplayName" class="@Classes.LineImage" />
                                    }
                                    else
                                    {
                                        <span>@Labels.FallbackItemText</span>
                                    }
                                </div>

                                <div>
                                    @if (!string.IsNullOrWhiteSpace(line.ProductUrl))
                                    {
                                        <a href="@line.ProductUrl" class="@Classes.LineTitle">@line.DisplayName</a>
                                    }
                                    else
                                    {
                                        <h2 class="@Classes.LineTitle">@line.DisplayName</h2>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(line.VariantLabel))
                                    {
                                        <p class="@Classes.LineMeta">@line.VariantLabel</p>
                                    }

                                    @foreach (var warning in line.Warnings)
                                    {
                                        <p class="@Classes.LineWarning">@warning.Message</p>
                                    }

                                    <div class="@Classes.LineControls">
                                        <div class="@Classes.LineMetrics">
                                            <div>
                                                <p class="@Classes.MetricLabel">@Labels.UnitPrice</p>
                                                <p class="@Classes.MetricValue">@line.UnitPriceDisplay</p>
                                            </div>

                                            <label>
                                                <span class="@Classes.MetricLabel">@Labels.Quantity</span>
                                                <input type="number"
                                                       min="@line.QuantityMinimum"
                                                       max="@line.QuantityMaximum"
                                                       step="@line.QuantityStep"
                                                       value="@line.Quantity"
                                                       disabled="@IsDisabled(line.LineId)"
                                                       data-storefront-cart-quantity
                                                       data-line-id="@line.LineId"
                                                       data-product-id="@line.ProductId"
                                                       data-variant-id="@line.ProductVariantId"
                                                       data-product-name="@line.DisplayName"
                                                       data-size-value="@line.VariantLabel"
                                                       @onchange="eventArgs => UpdateQuantityAsync(line, eventArgs.Value)"
                                                       class="@Classes.QuantityInput" />
                                            </label>

                                            <div>
                                                <p class="@Classes.MetricLabel">@Labels.LineTotal</p>
                                                <p class="@Classes.MetricValue">@line.LineTotalDisplay</p>
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(line.ProductUrl))
                                        {
                                            <a href="@line.ProductUrl" class="@Classes.PrimaryLink">@Labels.ViewProduct</a>
                                        }

                                        <button type="button"
                                                disabled="@IsDisabled(line.LineId)"
                                                data-storefront-cart-remove
                                                data-line-id="@line.LineId"
                                                data-product-id="@line.ProductId"
                                                data-variant-id="@line.ProductVariantId"
                                                data-product-name="@line.DisplayName"
                                                data-size-value="@line.VariantLabel"
                                                @onclick="() => RemoveLineAsync(line)"
                                                class="@Classes.RemoveButton">
                                            @Labels.Remove
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>

        <aside class="@Classes.SummaryAside">
            <div class="@Classes.SummaryCard">
                <p class="@Classes.Eyebrow">@Labels.OrderSummary</p>
                <h2 class="@Classes.EmptyTitle">@Labels.ReadyForCheckout</h2>

                <dl class="@Classes.SummaryRows">
                    <div class="@Classes.SummaryRow">
                        <dt>@Labels.Items</dt>
                        <dd>@ViewState.ItemCount</dd>
                    </div>
                    <div class="@Classes.SummaryRow">
                        <dt>@Labels.Subtotal</dt>
                        <dd>@GrandTotalDisplay</dd>
                    </div>
                    <div class="@Classes.SummaryRow">
                        <dt>@Labels.Total</dt>
                        <dd>@GrandTotalDisplay</dd>
                    </div>
                </dl>

                <div>
                    @if (Lines.Count > 0)
                    {
                        @if (ViewState.CheckoutAllowed)
                        {
                            <a href="@CheckoutUrl" class="@Classes.CheckoutButton">@Labels.ContinueToCheckout</a>
                        }
                        else
                        {
                            <button type="button" disabled class="@Classes.DisabledCheckoutButton">@Labels.ContinueToCheckout</button>
                        }
                        <p class="@Classes.BodyText">@Labels.CheckoutHandoffText</p>

                        <button type="button"
                                disabled="@CartController.IsClearDisabled()"
                                data-storefront-cart-clear
                                @onclick="ClearCartAsync"
                                class="@Classes.ClearButton">
                            @Labels.ClearCart
                        </button>
                    }

                    <a href="@ContinueShoppingUrl" class="@Classes.PrimaryLink">@Labels.KeepShopping</a>
                </div>
            </div>
        </aside>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public StorefrontBrowserCart? InitialCart { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<StorefrontBrowserCartAlert> InitialAlerts { get; set; } = default!;

    [Parameter, EditorRequired]
    public StorefrontFeatureDataMode DataMode { get; set; }

    [Parameter, EditorRequired]
    public StorefrontCartActionDescriptor Actions { get; set; } = default!;

    [Parameter, EditorRequired]
    public StorefrontCartViewClasses Classes { get; set; } = default!;

    [Parameter, EditorRequired]
    public StorefrontCartViewLabels Labels { get; set; } = default!;

    [Parameter, EditorRequired]
    public string CheckoutUrl { get; set; } = default!;

    [Parameter, EditorRequired]
    public string ContinueShoppingUrl { get; set; } = default!;

    [Parameter, EditorRequired]
    public string SecondaryShoppingUrl { get; set; } = default!;

    private IReadOnlyList<StorefrontBrowserCartAlert> Alerts => CartController.State.Alerts;

    private IReadOnlyList<StorefrontBrowserCartLine> Lines => CartController.State.Lines;

    private string GrandTotalDisplay => CartController.State.GrandTotalDisplay;

    private StorefrontCartViewState ViewState => StorefrontCartViewState.FromCart(CartController.State.Cart, CartController.State.Alerts);

    protected override void OnParametersSet()
    {
        ArgumentNullException.ThrowIfNull(InitialAlerts);
        ArgumentNullException.ThrowIfNull(Actions);
        ArgumentNullException.ThrowIfNull(Classes);
        ArgumentNullException.ThrowIfNull(Labels);
        ArgumentException.ThrowIfNullOrWhiteSpace(CheckoutUrl);
        ArgumentException.ThrowIfNullOrWhiteSpace(ContinueShoppingUrl);
        ArgumentException.ThrowIfNullOrWhiteSpace(SecondaryShoppingUrl);

        CartController.Initialize(InitialCart, InitialAlerts, DataMode, Actions);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !OperatingSystem.IsBrowser())
        {
            return;
        }

        if (await CartController.HydrateAsync())
        {
            StateHasChanged();
        }
    }

    private async Task UpdateQuantityAsync(StorefrontBrowserCartLine line, object? value)
    {
        if (await CartController.UpdateQuantityAsync(line.LineId, value))
        {
            StateHasChanged();
        }
    }

    private async Task RemoveLineAsync(StorefrontBrowserCartLine line)
    {
        if (await CartController.RemoveLineAsync(line.LineId))
        {
            StateHasChanged();
        }
    }

    private async Task ClearCartAsync()
    {
        if (await CartController.ClearAsync())
        {
            StateHasChanged();
        }
    }

    private bool IsDisabled(Guid lineId) => CartController.IsDisabled(lineId);

    private string AlertClass(StorefrontBrowserCartAlert alert)
    {
        return string.Join(
            " ",
            Classes.Alert,
            string.Equals(alert.Level, "error", StringComparison.OrdinalIgnoreCase) ? Classes.ErrorAlert : Classes.WarningAlert);
    }
}

@namespace BlazorShop.Storefront.Components.WasmHost.Components.Account
@inject IStorefrontBrowserAccountController AccountController

<div class="@Classes.Root" data-storefront-account-orders>
    @if (!string.IsNullOrWhiteSpace(AccountState.OrdersError))
    {
        <div class="@Classes.ErrorAlert" role="alert">@AccountState.OrdersError</div>
    }
    else if (AccountState.Orders.Items.Count == 0)
    {
        <p class="@Classes.EmptyState">@Labels.NoOrders</p>
    }
    else
    {
        <div class="@Classes.TableWrapper">
            <table class="@Classes.Table">
                <thead class="@Classes.TableHead">
                    <tr>
                        <th class="@Classes.HeaderCell">@Labels.Reference</th>
                        <th class="@Classes.HeaderCell">@Labels.Date</th>
                        <th class="@Classes.HeaderCell">@Labels.Status</th>
                        <th class="@Classes.HeaderCell">@Labels.Payment</th>
                        <th class="@Classes.HeaderCell">@Labels.Total</th>
                        <th class="@Classes.HeaderCell">@Labels.Items</th>
                    </tr>
                </thead>
                <tbody class="@Classes.TableBody">
                    @foreach (var order in AccountState.Orders.Items)
                    {
                        <tr>
                            <td class="@Classes.ReferenceCell">
                                <a class="@Classes.ReferenceLink" href="@Actions.OrderDetailHref(order.Reference)">@order.Reference</a>
                            </td>
                            <td class="@Classes.Cell">@order.CreatedOnDisplay</td>
                            <td class="@Classes.Cell">@order.OrderStatus</td>
                            <td class="@Classes.Cell">@order.PaymentStatus</td>
                            <td class="@Classes.StrongCell">@order.TotalDisplay</td>
                            <td class="@Classes.Cell">@order.ItemCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter]
    public StorefrontBrowserAccountOrderList InitialOrders { get; set; } = new([], 1, 10, 0, 0);

    [Parameter]
    public int PageNumber { get; set; } = 1;

    [Parameter]
    public string? InitialError { get; set; }

    [Parameter]
    public StorefrontFeatureDataMode DataMode { get; set; } = StorefrontFeatureDataMode.BrowserFetch;

    [Parameter]
    public StorefrontAccountOrderActionDescriptor Actions { get; set; } = StorefrontAccountOrderActionDescriptor.Empty;

    [Parameter]
    public StorefrontAccountOrderListClasses Classes { get; set; } = StorefrontAccountOrderListClasses.Empty;

    [Parameter]
    public StorefrontAccountOrderListLabels Labels { get; set; } = StorefrontAccountOrderListLabels.Empty;

    private StorefrontBrowserAccountState AccountState => AccountController.State;

    protected override void OnParametersSet()
    {
        ArgumentNullException.ThrowIfNull(Labels);
        AccountController.InitializeOrders(InitialOrders, InitialError, DataMode, Actions, PageNumber);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !OperatingSystem.IsBrowser() || DataMode == StorefrontFeatureDataMode.InitialSnapshot)
        {
            return;
        }

        if (await AccountController.HydrateOrdersAsync())
        {
            StateHasChanged();
        }
    }

}

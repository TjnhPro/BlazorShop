@namespace BlazorShop.Storefront.Components.WasmHost.Components.Account
@inject IStorefrontBrowserAccountController AccountController

<div class="@Classes.Root" data-storefront-account-profile>
    @if (!string.IsNullOrWhiteSpace(AccountState.ProfileSuccess))
    {
        <div class="@Classes.StatusAlert" role="status">@AccountState.ProfileSuccess</div>
    }
    @if (!string.IsNullOrWhiteSpace(AccountState.ProfileError))
    {
        <div class="@Classes.ErrorAlert" role="alert">@AccountState.ProfileError</div>
    }

    @if (AccountState.Profile is null)
    {
        <p class="@Classes.MissingProfile">@Labels.MissingProfile</p>
    }
    else
    {
        <form method="post" action="@Actions.FormAction" class="@Classes.ProfileForm" @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
            <AntiforgeryToken />
            @RenderAntiforgeryField()
            <label class="@Classes.WideField">
                <span class="@Classes.LabelText">@Labels.EmailAddress</span>
                <input name="Email" type="email" autocomplete="email" required @bind="AccountState.ProfileForm.Email" class="@Classes.Input" />
            </label>
            <label class="@Classes.WideField">
                <span class="@Classes.LabelText">@Labels.DisplayName</span>
                <input name="FullName" type="text" autocomplete="name" required @bind="AccountState.ProfileForm.FullName" class="@Classes.Input" />
            </label>
            <label class="@Classes.Field">
                <span class="@Classes.LabelText">@Labels.FirstName</span>
                <input name="FirstName" type="text" autocomplete="given-name" @bind="AccountState.ProfileForm.FirstName" class="@Classes.Input" />
            </label>
            <label class="@Classes.Field">
                <span class="@Classes.LabelText">@Labels.LastName</span>
                <input name="LastName" type="text" autocomplete="family-name" @bind="AccountState.ProfileForm.LastName" class="@Classes.Input" />
            </label>
            <label class="@Classes.Field">
                <span class="@Classes.LabelText">@Labels.Company</span>
                <input name="Company" type="text" autocomplete="organization" @bind="AccountState.ProfileForm.Company" class="@Classes.Input" />
            </label>
            <label class="@Classes.Field">
                <span class="@Classes.LabelText">@Labels.Phone</span>
                <input name="PhoneNumber" type="tel" autocomplete="tel" @bind="AccountState.ProfileForm.PhoneNumber" class="@Classes.Input" />
            </label>
            <label class="@Classes.Field">
                <span class="@Classes.LabelText">@Labels.Language</span>
                <input name="PreferredLanguage" type="text" @bind="AccountState.ProfileForm.PreferredLanguage" class="@Classes.Input" />
            </label>
            <label class="@Classes.Field">
                <span class="@Classes.LabelText">@Labels.Currency</span>
                <input name="PreferredCurrencyCode" type="text" maxlength="3" @bind="AccountState.ProfileForm.PreferredCurrencyCode" class="@Classes.CurrencyInput" />
            </label>
            <div class="@Classes.ActionRow">
                <button type="submit" disabled="@AccountState.ProfileSaving" class="@Classes.SubmitButton">@(AccountState.ProfileSaving ? Labels.Saving : Labels.SaveProfile)</button>
            </div>
        </form>
    }
</div>

@code {
    [Parameter]
    public StorefrontBrowserCustomerProfile? InitialProfile { get; set; }

    [Parameter]
    public string? InitialError { get; set; }

    [Parameter]
    public string? InitialSuccess { get; set; }

    [Parameter]
    public StorefrontAccountProfileActionDescriptor Actions { get; set; } = StorefrontAccountProfileActionDescriptor.Empty;

    [Parameter]
    public StorefrontAccountFormClasses Classes { get; set; } = StorefrontAccountFormClasses.Empty;

    [Parameter]
    public StorefrontAccountProfileLabels Labels { get; set; } = StorefrontAccountProfileLabels.Empty;

    [Parameter]
    public string? AntiforgeryFieldName { get; set; }

    [Parameter]
    public string? AntiforgeryRequestToken { get; set; }

    [Parameter]
    public StorefrontFeatureDataMode DataMode { get; set; } = StorefrontFeatureDataMode.BrowserFetch;

    private StorefrontBrowserAccountState AccountState => AccountController.State;

    protected override void OnParametersSet()
    {
        ArgumentNullException.ThrowIfNull(Labels);
        AccountController.InitializeProfile(InitialProfile, InitialError, InitialSuccess, DataMode, Actions);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !OperatingSystem.IsBrowser() || DataMode == StorefrontFeatureDataMode.InitialSnapshot)
        {
            return;
        }

        if (await AccountController.HydrateProfileAsync())
        {
            StateHasChanged();
        }
    }

    private async Task SaveAsync()
    {
        if (OperatingSystem.IsBrowser() && await AccountController.SaveProfileAsync())
        {
            StateHasChanged();
        }
    }

    private RenderFragment RenderAntiforgeryField() => builder =>
    {
        if (string.IsNullOrWhiteSpace(AntiforgeryFieldName) || string.IsNullOrWhiteSpace(AntiforgeryRequestToken))
        {
            return;
        }

        builder.OpenElement(0, "input");
        builder.AddAttribute(1, "type", "hidden");
        builder.AddAttribute(2, "name", AntiforgeryFieldName);
        builder.AddAttribute(3, "value", AntiforgeryRequestToken);
        builder.CloseElement();
    };
}

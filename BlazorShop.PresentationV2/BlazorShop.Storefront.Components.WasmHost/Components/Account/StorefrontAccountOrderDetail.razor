@namespace BlazorShop.Storefront.Components.WasmHost.Components.Account
@inject IStorefrontBrowserAccountController AccountController

<div class="@Classes.Root" data-storefront-account-order-detail>
    @if (!string.IsNullOrWhiteSpace(AccountState.OrderDetailError))
    {
        <div class="@Classes.ErrorAlert" role="alert">@AccountState.OrderDetailError</div>
    }
    else if (AccountState.OrderDetail is not null)
    {
        var order = AccountState.OrderDetail;
        <div class="@Classes.MetricsGrid">
            <div>
                <p class="@Classes.MetricLabel">@Labels.OrderStatus</p>
                <p class="@Classes.MetricValue">@order.OrderStatus</p>
            </div>
            <div>
                <p class="@Classes.MetricLabel">@Labels.Payment</p>
                <p class="@Classes.MetricValue">@order.PaymentStatus</p>
            </div>
            <div>
                <p class="@Classes.MetricLabel">@Labels.Total</p>
                <p class="@Classes.MetricValue">@order.TotalDisplay</p>
            </div>
        </div>

        <div class="@Classes.AddressGrid">
            @RenderAddress(Labels.ShippingAddress, order.ShippingAddress)
            @RenderAddress(Labels.BillingAddress, order.BillingAddress ?? order.ShippingAddress)
        </div>

        <section class="@Classes.ItemsSection">
            <h2 class="@Classes.SectionTitle">@Labels.Items</h2>
            <div class="@Classes.ItemsList">
                @foreach (var line in order.Lines)
                {
                    <div class="@Classes.LineRow">
                        <div>
                            <p class="@Classes.LineName">@line.ProductName</p>
                            @if (!string.IsNullOrWhiteSpace(line.Sku))
                            {
                                <p class="@Classes.LineSku">@line.Sku</p>
                            }
                        </div>
                        <p class="@Classes.LineText">@Labels.QuantityPrefix @line.Quantity</p>
                        <p class="@Classes.LineTotal">@line.LineTotalDisplay</p>
                    </div>
                }
            </div>
        </section>

        <section class="@Classes.TotalsSection">
            <h2 class="@Classes.SectionTitle">@Labels.Totals</h2>
            <div class="@Classes.TotalsBody">
                <div class="@Classes.TotalRow"><span>@Labels.Subtotal</span><span>@order.Totals.SubtotalDisplay</span></div>
                <div class="@Classes.TotalRow"><span>@Labels.Shipping</span><span>@order.Totals.ShippingDisplay</span></div>
                <div class="@Classes.TotalRow"><span>@Labels.Tax</span><span>@order.Totals.TaxDisplay</span></div>
                <div class="@Classes.TotalRow"><span>@Labels.Discount</span><span>@order.Totals.DiscountDisplay</span></div>
                <div class="@Classes.GrandTotalRow"><span>@Labels.GrandTotal</span><span>@order.Totals.GrandTotalDisplay</span></div>
            </div>
        </section>
    }
</div>

@code {
    [Parameter]
    public StorefrontBrowserAccountOrderDetail? InitialOrder { get; set; }

    [Parameter]
    public string? OrderReference { get; set; }

    [Parameter]
    public bool ReceiptMode { get; set; }

    [Parameter]
    public string? InitialError { get; set; }

    [Parameter]
    public StorefrontFeatureDataMode DataMode { get; set; } = StorefrontFeatureDataMode.BrowserFetch;

    [Parameter]
    public StorefrontAccountOrderActionDescriptor Actions { get; set; } = StorefrontAccountOrderActionDescriptor.Empty;

    [Parameter]
    public StorefrontAccountOrderDetailClasses Classes { get; set; } = StorefrontAccountOrderDetailClasses.Empty;

    [Parameter]
    public StorefrontAccountOrderDetailLabels Labels { get; set; } = StorefrontAccountOrderDetailLabels.Empty;

    private StorefrontBrowserAccountState AccountState => AccountController.State;

    protected override void OnParametersSet()
    {
        ArgumentNullException.ThrowIfNull(Labels);
        AccountController.InitializeOrderDetail(InitialOrder, InitialError, DataMode, Actions, OrderReference, ReceiptMode);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender
            || !OperatingSystem.IsBrowser()
            || DataMode == StorefrontFeatureDataMode.InitialSnapshot
            || string.IsNullOrWhiteSpace(OrderReference))
        {
            return;
        }

        if (await AccountController.HydrateOrderDetailAsync())
        {
            StateHasChanged();
        }
    }

    private RenderFragment RenderAddress(string title, StorefrontBrowserOrderAddress address) => builder =>
    {
        builder.OpenElement(0, "section");
        builder.AddAttribute(1, "class", Classes.AddressSection);
        builder.OpenElement(2, "h2");
        builder.AddAttribute(3, "class", Classes.AddressTitle);
        builder.AddContent(4, title);
        builder.CloseElement();
        builder.OpenElement(5, "div");
        builder.AddAttribute(6, "class", Classes.AddressBody);
        AddAddressLine(builder, 7, address.FullName, Classes.AddressStrongLine);
        AddAddressLine(builder, 10, address.Address1, null);
        AddAddressLine(builder, 13, address.Address2, null);
        AddAddressLine(builder, 16, string.Join(", ", new[] { address.City, address.PostalCode }.Where(part => !string.IsNullOrWhiteSpace(part))), null);
        AddAddressLine(builder, 19, address.CountryCode, null);
        builder.CloseElement();
        builder.CloseElement();
    };

    private static void AddAddressLine(RenderTreeBuilder builder, int sequence, string? value, string? cssClass)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return;
        }

        builder.OpenElement(sequence, "p");
        if (!string.IsNullOrWhiteSpace(cssClass))
        {
            builder.AddAttribute(sequence + 1, "class", cssClass);
        }

        builder.AddContent(sequence + 2, value);
        builder.CloseElement();
    }
}

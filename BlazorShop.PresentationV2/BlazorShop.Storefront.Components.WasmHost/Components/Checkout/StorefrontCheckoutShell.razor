@namespace BlazorShop.Storefront.Components.WasmHost.Components.Checkout
@inject IStorefrontBrowserCheckoutController CheckoutController
@inject NavigationManager NavigationManager

@if (ShowPanel)
{
    <section class="@Classes.Shell" data-storefront-checkout-shell>
        <div class="@Classes.HeaderLayout">
            <div>
                <p class="@Classes.Eyebrow">@Labels.StateLabel</p>
                <h2 class="@Classes.Title">@Title</h2>
                @if (!string.IsNullOrWhiteSpace(CurrentCheckout.Message))
                {
                    <p class="@Classes.BodyText">@CurrentCheckout.Message</p>
                }
            </div>
            <button type="button" class="@Classes.RefreshButton" @onclick="RefreshAsync" disabled="@ControllerState.Loading">
                @(ControllerState.Loading ? Labels.Refreshing : Labels.Refresh)
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(ControllerState.Error))
        {
            <div class="@Classes.Error" role="alert">@ControllerState.Error</div>
        }

        @if (CurrentCheckout.HasCart)
        {
            <div class="@Classes.MetricsGrid">
                <div class="@Classes.MetricCard">
                    <p class="@Classes.Eyebrow">@Labels.CartVersion</p>
                    <p class="@Classes.MetricValue" data-storefront-checkout-cart-version>@CurrentCheckout.CartVersion</p>
                </div>
                <div class="@Classes.MetricCard">
                    <p class="@Classes.Eyebrow">@Labels.CheckoutVersion</p>
                    <p class="@Classes.MetricValue">@CurrentCheckout.CheckoutVersion</p>
                </div>
                <div class="@Classes.MetricCard">
                    <p class="@Classes.Eyebrow">@Labels.Total</p>
                    <p class="@Classes.MetricValue">@CurrentCheckout.GrandTotalDisplay</p>
                </div>
            </div>

            @if (CurrentCheckout.Issues.Count > 0)
            {
                <div class="@Classes.IssuePanel">
                    @foreach (var issue in CurrentCheckout.Issues)
                    {
                        <p>@issue.Message</p>
                    }
                </div>
            }

            <div class="@Classes.OptionGrid">
                <section class="@Classes.OptionPanel">
                    <h3>@Labels.Shipping</h3>
                    <div class="@Classes.OptionList">
                        @if (!CurrentCheckout.ShippingRequired)
                        {
                            <p>@Labels.ShippingNotRequired</p>
                        }
                        else if (CurrentCheckout.ShippingOptions.Count == 0)
                        {
                            <p>@Labels.ShippingUnavailable</p>
                        }
                        else
                        {
                            @foreach (var option in CurrentCheckout.ShippingOptions)
                            {
                                <label class="@Classes.OptionLabel">
                                    <input type="radio" name="wasmShippingOption" checked="@option.Selected" @onchange="() => SelectShippingAsync(option.Key)" />
                                    <span>
                                        <span>@option.DisplayName</span>
                                        @if (!string.IsNullOrWhiteSpace(option.AmountDisplay))
                                        {
                                            <span>@option.AmountDisplay</span>
                                        }
                                    </span>
                                </label>
                            }
                        }
                    </div>
                </section>

                <section class="@Classes.OptionPanel">
                    <h3>@Labels.Payment</h3>
                    <div class="@Classes.OptionList">
                        @foreach (var method in CurrentCheckout.PaymentMethods)
                        {
                            <label class="@Classes.OptionLabel">
                                <input type="radio" name="wasmPaymentMethod" checked="@method.Selected" @onchange="() => SelectPaymentAsync(method.Key)" />
                                <span>
                                    <span>@method.DisplayName</span>
                                    @if (!string.IsNullOrWhiteSpace(method.Description))
                                    {
                                        <span>@method.Description</span>
                                    }
                                </span>
                            </label>
                        }
                    </div>
                </section>
            </div>

            <button type="button" class="@Classes.PrimaryButton" @onclick="ReviewAsync" disabled="@ControllerState.Loading">
                @Labels.ReviewLatestCheckout
            </button>
            @if (CurrentCheckout.PlaceOrderAllowed)
            {
                <button type="button" class="@Classes.SecondaryButton" @onclick="PlaceOrderAsync" disabled="@ControllerState.Loading">
                    @Labels.PlaceOrder
                </button>
            }
        }
    </section>
}

@code {
    [Parameter, EditorRequired]
    public StorefrontBrowserCheckoutState InitialState { get; set; } = default!;

    [Parameter, EditorRequired]
    public bool ShowPanel { get; set; }

    [Parameter, EditorRequired]
    public StorefrontFeatureDataMode DataMode { get; set; }

    [Parameter, EditorRequired]
    public StorefrontCheckoutActionDescriptor Actions { get; set; } = default!;

    [Parameter, EditorRequired]
    public StorefrontCheckoutViewClasses Classes { get; set; } = default!;

    [Parameter, EditorRequired]
    public StorefrontCheckoutViewLabels Labels { get; set; } = default!;

    private StorefrontBrowserCheckoutControllerState ControllerState => CheckoutController.State;

    private StorefrontBrowserCheckoutState CurrentCheckout => ControllerState.Checkout;

    private string Title => !CurrentCheckout.HasCart
        ? Labels.EmptyCartTitle
        : $"{CurrentCheckout.CurrentStep} {Labels.ReadySuffix}";

    private StorefrontCheckoutViewState ViewState => StorefrontCheckoutViewState.FromState(CurrentCheckout, ControllerState.Loading, ControllerState.Error);

    protected override void OnParametersSet()
    {
        ArgumentNullException.ThrowIfNull(InitialState);
        ArgumentNullException.ThrowIfNull(Actions);
        ArgumentNullException.ThrowIfNull(Classes);
        ArgumentNullException.ThrowIfNull(Labels);

        CheckoutController.Initialize(InitialState, ShowPanel, DataMode, Actions);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ShowPanel
            && firstRender
            && OperatingSystem.IsBrowser()
            && DataMode != StorefrontFeatureDataMode.InitialSnapshot)
        {
            if (await CheckoutController.HydrateAsync())
            {
                StateHasChanged();
            }
        }
    }

    private async Task RefreshAsync()
    {
        if (await CheckoutController.RefreshAsync())
        {
            StateHasChanged();
        }
    }

    private async Task SelectShippingAsync(string key)
    {
        if (await CheckoutController.SelectShippingAsync(key))
        {
            StateHasChanged();
        }
    }

    private async Task SelectPaymentAsync(string key)
    {
        if (await CheckoutController.SelectPaymentAsync(key))
        {
            StateHasChanged();
        }
    }

    private async Task ReviewAsync()
    {
        if (await CheckoutController.ReviewAsync())
        {
            StateHasChanged();
        }
    }

    private async Task PlaceOrderAsync()
    {
        var outcomeTask = CheckoutController.PlaceOrderAsync();
        StateHasChanged();

        var outcome = await outcomeTask;
        if (!string.IsNullOrWhiteSpace(outcome.RedirectUrl))
        {
            NavigationManager.NavigateTo(outcome.RedirectUrl, forceLoad: true);
        }
        else if (outcome.Changed)
        {
            StateHasChanged();
        }
    }
}

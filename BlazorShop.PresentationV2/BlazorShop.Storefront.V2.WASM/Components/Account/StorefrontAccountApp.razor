@using BlazorShop.Storefront.Components.Browser
@using BlazorShop.Storefront.Components.Contracts.Account
@using BlazorShop.Storefront.Components.Headless.Account

<section class="@ShellClasses.Section" data-storefront-account-app>
    <div class="@ShellClasses.Layout">
        <StorefrontAccountNavigation
            ActiveRoute="@ActiveRoute.NavRoute"
            Items="NavigationItems"
            Classes="NavigationClasses" />

        <article class="@ShellClasses.ContentArticle">
            <header class="@ShellClasses.Header">
                <p class="@ShellClasses.Eyebrow">Customer account</p>
                <h1 class="@ShellClasses.Title">@Title</h1>
            </header>

            <div class="@ShellClasses.Body">
                @RenderActivePanel()
            </div>
        </article>
    </div>
</section>

@code {
    [Parameter]
    public string? Path { get; set; }

    [Parameter]
    public int PageNumber { get; set; } = 1;

    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public string? Saved { get; set; }

    [Parameter]
    public string? AntiforgeryFieldName { get; set; }

    [Parameter]
    public string? AntiforgeryRequestToken { get; set; }

    [Parameter]
    public IReadOnlyList<AccountNavigationItem> NavigationItems { get; set; } = [];

    [Parameter]
    public AccountRouteDescriptor RouteDescriptor { get; set; } = AccountRouteDescriptor.Empty;

    [Parameter]
    public AccountNavigationClasses NavigationClasses { get; set; } = AccountNavigationClasses.Empty;

    [Parameter]
    public StorefrontAccountProfileActionDescriptor ProfileActions { get; set; } = StorefrontAccountProfileActionDescriptor.Empty;

    [Parameter]
    public StorefrontAccountPasswordActionDescriptor PasswordActions { get; set; } = StorefrontAccountPasswordActionDescriptor.Empty;

    [Parameter]
    public StorefrontAccountFormClasses AccountFormClasses { get; set; } = StorefrontAccountFormClasses.Empty;

    [Parameter]
    public StorefrontAccountAddressActionDescriptor AddressActions { get; set; } = StorefrontAccountAddressActionDescriptor.Empty;

    [Parameter]
    public StorefrontAccountAddressBookClasses AddressClasses { get; set; } = StorefrontAccountAddressBookClasses.Empty;

    [Parameter]
    public StorefrontAccountOrderActionDescriptor OrderActions { get; set; } = StorefrontAccountOrderActionDescriptor.Empty;

    [Parameter]
    public StorefrontAccountOrderListClasses OrderListClasses { get; set; } = StorefrontAccountOrderListClasses.Empty;

    [Parameter]
    public StorefrontAccountOrderDetailClasses OrderDetailClasses { get; set; } = StorefrontAccountOrderDetailClasses.Empty;

    [Parameter]
    public StorefrontAccountShellClasses ShellClasses { get; set; } = StorefrontAccountShellClasses.Empty;

    private AccountRouteMatch ActiveRoute => AccountRouteParser.Resolve(Path, RouteDescriptor);

    private string Title => ActiveRoute.Kind switch
    {
        AccountRouteKind.Profile => "Profile",
        AccountRouteKind.Addresses => "Addresses",
        AccountRouteKind.Orders => "Orders",
        AccountRouteKind.OrderDetail => $"{(ActiveRoute.ReceiptMode ? "Receipt" : "Order")} {ActiveRoute.OrderReference}".Trim(),
        AccountRouteKind.ChangePassword => "Change password",
        _ => "Account section not found"
    };

    private RenderFragment RenderActivePanel() => builder =>
    {
        switch (ActiveRoute.Kind)
        {
            case AccountRouteKind.Profile:
                builder.OpenComponent<StorefrontAccountProfileEditor>(0);
                builder.AddAttribute(1, nameof(StorefrontAccountProfileEditor.InitialError), Error);
                builder.AddAttribute(2, nameof(StorefrontAccountProfileEditor.InitialSuccess), Saved == "1" ? "Profile updated." : null);
                builder.AddAttribute(3, nameof(StorefrontAccountProfileEditor.Actions), ProfileActions);
                builder.AddAttribute(4, nameof(StorefrontAccountProfileEditor.AntiforgeryFieldName), AntiforgeryFieldName);
                builder.AddAttribute(5, nameof(StorefrontAccountProfileEditor.AntiforgeryRequestToken), AntiforgeryRequestToken);
                builder.AddAttribute(6, nameof(StorefrontAccountProfileEditor.DataMode), StorefrontFeatureDataMode.BrowserFetch);
                builder.AddAttribute(7, nameof(StorefrontAccountProfileEditor.Classes), AccountFormClasses);
                builder.CloseComponent();
                break;

            case AccountRouteKind.Addresses:
                builder.OpenComponent<StorefrontAccountAddressBook>(10);
                builder.AddAttribute(11, nameof(StorefrontAccountAddressBook.InitialError), Error);
                builder.AddAttribute(12, nameof(StorefrontAccountAddressBook.InitialSuccess), Saved == "1" ? "Address book updated." : null);
                builder.AddAttribute(13, nameof(StorefrontAccountAddressBook.Actions), AddressActions);
                builder.AddAttribute(14, nameof(StorefrontAccountAddressBook.AntiforgeryFieldName), AntiforgeryFieldName);
                builder.AddAttribute(15, nameof(StorefrontAccountAddressBook.AntiforgeryRequestToken), AntiforgeryRequestToken);
                builder.AddAttribute(16, nameof(StorefrontAccountAddressBook.DataMode), StorefrontFeatureDataMode.BrowserFetch);
                builder.AddAttribute(17, nameof(StorefrontAccountAddressBook.Classes), AddressClasses);
                builder.CloseComponent();
                break;

            case AccountRouteKind.Orders:
                builder.OpenComponent<StorefrontAccountOrderList>(20);
                builder.AddAttribute(21, nameof(StorefrontAccountOrderList.InitialError), Error);
                builder.AddAttribute(22, nameof(StorefrontAccountOrderList.PageNumber), Math.Max(1, PageNumber));
                builder.AddAttribute(23, nameof(StorefrontAccountOrderList.DataMode), StorefrontFeatureDataMode.BrowserFetch);
                builder.AddAttribute(24, nameof(StorefrontAccountOrderList.Actions), OrderActions);
                builder.AddAttribute(25, nameof(StorefrontAccountOrderList.Classes), OrderListClasses);
                builder.CloseComponent();
                break;

            case AccountRouteKind.OrderDetail:
                builder.OpenComponent<StorefrontAccountOrderDetail>(30);
                builder.AddAttribute(31, nameof(StorefrontAccountOrderDetail.InitialError), Error);
                builder.AddAttribute(32, nameof(StorefrontAccountOrderDetail.OrderReference), ActiveRoute.OrderReference);
                builder.AddAttribute(33, nameof(StorefrontAccountOrderDetail.ReceiptMode), ActiveRoute.ReceiptMode);
                builder.AddAttribute(34, nameof(StorefrontAccountOrderDetail.DataMode), StorefrontFeatureDataMode.BrowserFetch);
                builder.AddAttribute(35, nameof(StorefrontAccountOrderDetail.Actions), OrderActions);
                builder.AddAttribute(36, nameof(StorefrontAccountOrderDetail.Classes), OrderDetailClasses);
                builder.CloseComponent();
                break;

            case AccountRouteKind.ChangePassword:
                builder.OpenComponent<StorefrontAccountChangePasswordForm>(40);
                builder.AddAttribute(41, nameof(StorefrontAccountChangePasswordForm.InitialError), Error);
                builder.AddAttribute(42, nameof(StorefrontAccountChangePasswordForm.InitialSuccess), Saved == "1" ? "Password changed." : null);
                builder.AddAttribute(43, nameof(StorefrontAccountChangePasswordForm.Actions), PasswordActions);
                builder.AddAttribute(44, nameof(StorefrontAccountChangePasswordForm.AntiforgeryFieldName), AntiforgeryFieldName);
                builder.AddAttribute(45, nameof(StorefrontAccountChangePasswordForm.AntiforgeryRequestToken), AntiforgeryRequestToken);
                builder.AddAttribute(46, nameof(StorefrontAccountChangePasswordForm.DataMode), StorefrontFeatureDataMode.BrowserFetch);
                builder.AddAttribute(47, nameof(StorefrontAccountChangePasswordForm.Classes), AccountFormClasses);
                builder.CloseComponent();
                break;

            default:
                builder.OpenElement(50, "div");
                builder.AddAttribute(51, "class", ShellClasses.UnknownAlert);
                builder.AddAttribute(52, "role", "alert");
                builder.AddContent(53, "The account section could not be found.");
                builder.CloseElement();
                break;
        }
    };

}

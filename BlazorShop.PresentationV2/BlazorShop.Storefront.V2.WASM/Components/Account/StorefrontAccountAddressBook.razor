@using BlazorShop.Storefront.Components.Browser
@using BlazorShop.Storefront.Browser.Account
@using BlazorShop.Storefront.Components.Headless.Account
@inject IStorefrontBrowserAccountController AccountController

<div class="@Classes.Root" data-storefront-account-addresses>
    @if (!string.IsNullOrWhiteSpace(AccountState.AddressSuccess))
    {
        <div class="@Classes.StatusAlert" role="status">@AccountState.AddressSuccess</div>
    }
    @if (!string.IsNullOrWhiteSpace(AccountState.AddressError))
    {
        <div class="@Classes.ErrorAlert" role="alert">@AccountState.AddressError</div>
    }

    <section class="@Classes.AddSection">
        <h2 class="@Classes.AddTitle">Add address</h2>
        <form method="post" action="@Actions.FormAction" class="@Classes.AddForm" @onsubmit="CreateAsync" @onsubmit:preventDefault="true">
            <AntiforgeryToken />
            @RenderAntiforgeryField()
            <input type="hidden" name="Action" value="create" />
            @RenderAddressInputs(AccountState.NewAddress, false)
            <div class="@Classes.ActionRow">
                <button class="@Classes.PrimaryButton" type="submit" disabled="@AccountState.AddressSaving">Save address</button>
            </div>
        </form>
    </section>

    @if (AccountState.Addresses.Count == 0)
    {
        <p class="@Classes.EmptyState">No saved addresses yet.</p>
    }
    else
    {
        <div class="@Classes.ListGrid">
            @foreach (var address in AccountState.Addresses)
            {
                var form = AccountState.AddressForms[address.PublicId];
                <section class="@Classes.Card" @key="address.PublicId">
                    <div class="@Classes.BadgeRow">
                        @if (address.IsDefaultShipping)
                        {
                            <span class="@Classes.ShippingBadge">Default shipping</span>
                        }
                        @if (address.IsDefaultBilling)
                        {
                            <span class="@Classes.BillingBadge">Default billing</span>
                        }
                    </div>
                    <h2 class="@Classes.CardTitle">@address.FullName</h2>
                    @if (!string.IsNullOrWhiteSpace(address.Company))
                    {
                        <p class="@Classes.AddressTextSpaced">@address.Company</p>
                    }
                    <p class="@Classes.AddressTextSpaced">@address.Address1</p>
                    @if (!string.IsNullOrWhiteSpace(address.Address2))
                    {
                        <p class="@Classes.AddressText">@address.Address2</p>
                    }
                    <p class="@Classes.AddressText">@address.City, @address.PostalCode</p>
                    <p class="@Classes.AddressText">@address.CountryCode</p>

                    <form method="post" action="@Actions.FormAction" class="@Classes.EditForm" @onsubmit="() => UpdateAsync(address.PublicId)" @onsubmit:preventDefault="true">
                        <AntiforgeryToken />
                        @RenderAntiforgeryField()
                        <input type="hidden" name="AddressId" value="@address.PublicId" />
                        <div class="@Classes.EditFieldsGrid">
                            @RenderAddressInputs(form, true)
                        </div>
                        <div class="@Classes.EditActions">
                            <button class="@Classes.PrimaryButton" type="submit" name="Action" value="update">Update</button>
                            <button class="@Classes.SecondaryButton" type="button" @onclick="() => SetDefaultAsync(address.PublicId, true)">Default shipping</button>
                            <button class="@Classes.SecondaryButton" type="button" @onclick="() => SetDefaultAsync(address.PublicId, false)">Default billing</button>
                            <button class="@Classes.DangerButton" type="button" @onclick="() => DeleteAsync(address.PublicId)">Delete</button>
                        </div>
                    </form>
                </section>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<StorefrontBrowserCustomerAddress> InitialAddresses { get; set; } = [];

    [Parameter]
    public string? InitialError { get; set; }

    [Parameter]
    public string? InitialSuccess { get; set; }

    [Parameter]
    public StorefrontAccountAddressActionDescriptor Actions { get; set; } = StorefrontAccountAddressActionDescriptor.Empty;

    [Parameter]
    public StorefrontAccountAddressBookClasses Classes { get; set; } = StorefrontAccountAddressBookClasses.Empty;

    [Parameter]
    public string? AntiforgeryFieldName { get; set; }

    [Parameter]
    public string? AntiforgeryRequestToken { get; set; }

    [Parameter]
    public StorefrontFeatureDataMode DataMode { get; set; } = StorefrontFeatureDataMode.BrowserFetch;

    private StorefrontBrowserAccountState AccountState => AccountController.State;

    protected override void OnParametersSet()
    {
        AccountController.InitializeAddresses(InitialAddresses, InitialError, InitialSuccess, DataMode, Actions);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !OperatingSystem.IsBrowser() || DataMode == StorefrontFeatureDataMode.InitialSnapshot)
        {
            return;
        }

        if (await AccountController.HydrateAddressesAsync())
        {
            StateHasChanged();
        }
    }

    private async Task CreateAsync()
    {
        if (await AccountController.CreateAddressAsync())
        {
            StateHasChanged();
        }
    }

    private async Task UpdateAsync(Guid addressId)
    {
        if (await AccountController.UpdateAddressAsync(addressId))
        {
            StateHasChanged();
        }
    }

    private async Task DeleteAsync(Guid addressId)
    {
        if (await AccountController.DeleteAddressAsync(addressId))
        {
            StateHasChanged();
        }
    }

    private async Task SetDefaultAsync(Guid addressId, bool shipping)
    {
        if (await AccountController.SetDefaultAddressAsync(addressId, shipping))
        {
            StateHasChanged();
        }
    }

    private RenderFragment RenderAddressInputs(StorefrontBrowserAccountAddressForm form, bool compact) => builder =>
    {
        AddTextInput(builder, 0, form, nameof(form.FullName), "Full name", "name", true, value => form.FullName = value ?? string.Empty, form.FullName, compact);
        AddTextInput(builder, 10, form, nameof(form.Company), "Company", "organization", false, value => form.Company = value, form.Company, compact);
        AddTextInput(builder, 20, form, nameof(form.Email), "Email", "email", false, value => form.Email = value, form.Email, compact, type: "email");
        AddTextInput(builder, 30, form, nameof(form.Phone), "Phone", "tel", false, value => form.Phone = value, form.Phone, compact);
        AddTextInput(builder, 40, form, nameof(form.Address1), "Address line 1", "address-line1", true, value => form.Address1 = value ?? string.Empty, form.Address1, compact, spanTwo: true);
        AddTextInput(builder, 50, form, nameof(form.Address2), "Address line 2", "address-line2", false, value => form.Address2 = value, form.Address2, compact, spanTwo: true);
        AddTextInput(builder, 60, form, nameof(form.City), "City", "address-level2", true, value => form.City = value ?? string.Empty, form.City, compact);
        AddTextInput(builder, 70, form, nameof(form.StateProvinceName), "State / province", "address-level1", false, value => form.StateProvinceName = value, form.StateProvinceName, compact);
        AddTextInput(builder, 80, form, nameof(form.PostalCode), "Postal code", "postal-code", true, value => form.PostalCode = value ?? string.Empty, form.PostalCode, compact);
        AddTextInput(builder, 90, form, nameof(form.CountryCode), "Country code", "country", true, value => form.CountryCode = value ?? string.Empty, form.CountryCode, compact, maxLength: 2);
    };

    private RenderFragment RenderAntiforgeryField() => builder =>
    {
        if (string.IsNullOrWhiteSpace(AntiforgeryFieldName) || string.IsNullOrWhiteSpace(AntiforgeryRequestToken))
        {
            return;
        }

        builder.OpenElement(0, "input");
        builder.AddAttribute(1, "type", "hidden");
        builder.AddAttribute(2, "name", AntiforgeryFieldName);
        builder.AddAttribute(3, "value", AntiforgeryRequestToken);
        builder.CloseElement();
    };

    private void AddTextInput(
        RenderTreeBuilder builder,
        int sequence,
        StorefrontBrowserAccountAddressForm form,
        string name,
        string label,
        string autocomplete,
        bool required,
        Action<string?> setter,
        string? value,
        bool compact,
        string type = "text",
        bool spanTwo = false,
        int? maxLength = null)
    {
        var labelClass = compact
            ? (spanTwo ? Classes.CompactWideField : Classes.CompactField)
            : (spanTwo ? Classes.FullWideField : Classes.FullField);
        builder.OpenElement(sequence, "label");
        builder.AddAttribute(sequence + 1, "class", labelClass);
        builder.AddContent(sequence + 2, label);
        builder.OpenElement(sequence + 3, "input");
        builder.AddAttribute(sequence + 4, "class", compact ? Classes.CompactInput : Classes.FullInput);
        builder.AddAttribute(sequence + 5, "name", name);
        builder.AddAttribute(sequence + 6, "autocomplete", autocomplete);
        builder.AddAttribute(sequence + 7, "type", type);
        builder.AddAttribute(sequence + 8, "value", value);
        builder.AddAttribute(sequence + 9, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(form, args => setter(args.Value?.ToString())));
        if (required)
        {
            builder.AddAttribute(sequence + 10, "required", true);
        }

        if (maxLength.HasValue)
        {
            builder.AddAttribute(sequence + 11, "maxlength", maxLength.Value);
        }

        builder.CloseElement();
        builder.CloseElement();
    }
}

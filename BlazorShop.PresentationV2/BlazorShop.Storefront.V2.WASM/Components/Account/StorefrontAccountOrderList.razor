@using BlazorShop.Storefront.Components.Browser
@using BlazorShop.Storefront.Components.Headless.Account
@inject IServiceProvider Services

<div class="@Classes.Root" data-storefront-account-orders>
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="@Classes.ErrorAlert" role="alert">@_error</div>
    }
    else if (_orders.Items.Count == 0)
    {
        <p class="@Classes.EmptyState">No orders yet.</p>
    }
    else
    {
        <div class="@Classes.TableWrapper">
            <table class="@Classes.Table">
                <thead class="@Classes.TableHead">
                    <tr>
                        <th class="@Classes.HeaderCell">Reference</th>
                        <th class="@Classes.HeaderCell">Date</th>
                        <th class="@Classes.HeaderCell">Status</th>
                        <th class="@Classes.HeaderCell">Payment</th>
                        <th class="@Classes.HeaderCell">Total</th>
                        <th class="@Classes.HeaderCell">Items</th>
                    </tr>
                </thead>
                <tbody class="@Classes.TableBody">
                    @foreach (var order in _orders.Items)
                    {
                        <tr>
                            <td class="@Classes.ReferenceCell">
                                <a class="@Classes.ReferenceLink" href="@Actions.OrderDetailHref(order.Reference)">@order.Reference</a>
                            </td>
                            <td class="@Classes.Cell">@order.CreatedOnDisplay</td>
                            <td class="@Classes.Cell">@order.OrderStatus</td>
                            <td class="@Classes.Cell">@order.PaymentStatus</td>
                            <td class="@Classes.StrongCell">@order.TotalDisplay</td>
                            <td class="@Classes.Cell">@order.ItemCount</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter]
    public StorefrontBrowserAccountOrderList InitialOrders { get; set; } = new([], 1, 10, 0, 0);

    [Parameter]
    public int PageNumber { get; set; } = 1;

    [Parameter]
    public string? InitialError { get; set; }

    [Parameter]
    public StorefrontFeatureDataMode DataMode { get; set; } = StorefrontFeatureDataMode.BrowserFetch;

    [Parameter]
    public StorefrontAccountOrderActionDescriptor Actions { get; set; } = StorefrontAccountOrderActionDescriptor.Empty;

    [Parameter]
    public StorefrontAccountOrderListClasses Classes { get; set; } = StorefrontAccountOrderListClasses.Empty;

    private StorefrontBrowserAccountOrderList _orders = new([], 1, 10, 0, 0);
    private string? _error;

    protected override void OnParametersSet()
    {
        _orders = InitialOrders;
        _error = InitialError;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !OperatingSystem.IsBrowser() || DataMode == StorefrontFeatureDataMode.InitialSnapshot)
        {
            return;
        }

        var apiClient = Services.GetService(typeof(StorefrontLocalApiClient)) as StorefrontLocalApiClient;
        if (apiClient is null)
        {
            return;
        }

        var result = await apiClient.GetAsync<StorefrontBrowserAccountOrderList>(Actions.OrderListRoute(PageNumber));
        if (result.Success && result.Data is not null)
        {
            _orders = result.Data;
            _error = null;
            StateHasChanged();
        }
    }

}

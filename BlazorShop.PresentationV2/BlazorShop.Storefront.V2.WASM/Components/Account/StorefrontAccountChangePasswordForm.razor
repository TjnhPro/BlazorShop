@using BlazorShop.Storefront.Components.Browser
@using BlazorShop.Storefront.Browser.Account
@using BlazorShop.Storefront.Components.Headless.Account
@inject IStorefrontBrowserAccountController AccountController

<div class="@Classes.Root" data-storefront-account-password>
    @if (!string.IsNullOrWhiteSpace(AccountState.PasswordSuccess))
    {
        <div class="@Classes.StatusAlert" role="status">@AccountState.PasswordSuccess</div>
    }
    @if (!string.IsNullOrWhiteSpace(AccountState.PasswordError))
    {
        <div class="@Classes.ErrorAlert" role="alert">@AccountState.PasswordError</div>
    }

    <form method="post" action="@Actions.FormAction" class="@Classes.PasswordForm" @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
        <AntiforgeryToken />
        @RenderAntiforgeryField()
        <label class="@Classes.Field">
            <span class="@Classes.LabelText">Current password</span>
            <input name="CurrentPassword" type="password" autocomplete="current-password" required @bind="AccountState.PasswordForm.CurrentPassword" class="@Classes.Input" />
        </label>
        <label class="@Classes.Field">
            <span class="@Classes.LabelText">New password</span>
            <input name="NewPassword" type="password" autocomplete="new-password" required minlength="8" @bind="AccountState.PasswordForm.NewPassword" class="@Classes.Input" />
        </label>
        <label class="@Classes.Field">
            <span class="@Classes.LabelText">Confirm new password</span>
            <input name="ConfirmPassword" type="password" autocomplete="new-password" required minlength="8" @bind="AccountState.PasswordForm.ConfirmPassword" class="@Classes.Input" />
        </label>
        <button type="submit" disabled="@AccountState.PasswordSaving" class="@Classes.SubmitButton">@(AccountState.PasswordSaving ? "Changing..." : "Change password")</button>
    </form>
</div>

@code {
    [Parameter]
    public string? InitialError { get; set; }

    [Parameter]
    public string? InitialSuccess { get; set; }

    [Parameter]
    public StorefrontAccountPasswordActionDescriptor Actions { get; set; } = StorefrontAccountPasswordActionDescriptor.Empty;

    [Parameter]
    public StorefrontAccountFormClasses Classes { get; set; } = StorefrontAccountFormClasses.Empty;

    [Parameter]
    public string? AntiforgeryFieldName { get; set; }

    [Parameter]
    public string? AntiforgeryRequestToken { get; set; }

    [Parameter]
    public StorefrontFeatureDataMode DataMode { get; set; } = StorefrontFeatureDataMode.BrowserFetch;

    private StorefrontBrowserAccountState AccountState => AccountController.State;

    protected override void OnParametersSet()
    {
        AccountController.InitializePassword(InitialError, InitialSuccess, Actions);
    }

    private async Task SaveAsync()
    {
        if (OperatingSystem.IsBrowser() && await AccountController.ChangePasswordAsync())
        {
            StateHasChanged();
        }
    }

    private RenderFragment RenderAntiforgeryField() => builder =>
    {
        if (string.IsNullOrWhiteSpace(AntiforgeryFieldName) || string.IsNullOrWhiteSpace(AntiforgeryRequestToken))
        {
            return;
        }

        builder.OpenElement(0, "input");
        builder.AddAttribute(1, "type", "hidden");
        builder.AddAttribute(2, "name", AntiforgeryFieldName);
        builder.AddAttribute(3, "value", AntiforgeryRequestToken);
        builder.CloseElement();
    };
}

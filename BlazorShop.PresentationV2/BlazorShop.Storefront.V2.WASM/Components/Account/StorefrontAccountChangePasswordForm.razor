@using BlazorShop.Storefront.Components.Browser
@using BlazorShop.Storefront.Components.Headless.Account
@inject IServiceProvider Services

<div class="@Classes.Root" data-storefront-account-password>
    @if (!string.IsNullOrWhiteSpace(_success))
    {
        <div class="@Classes.StatusAlert" role="status">@_success</div>
    }
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="@Classes.ErrorAlert" role="alert">@_error</div>
    }

    <form method="post" action="@Actions.FormAction" class="@Classes.PasswordForm" @onsubmit="SaveAsync" @onsubmit:preventDefault="true">
        <AntiforgeryToken />
        @RenderAntiforgeryField()
        <label class="@Classes.Field">
            <span class="@Classes.LabelText">Current password</span>
            <input name="CurrentPassword" type="password" autocomplete="current-password" required @bind="_currentPassword" class="@Classes.Input" />
        </label>
        <label class="@Classes.Field">
            <span class="@Classes.LabelText">New password</span>
            <input name="NewPassword" type="password" autocomplete="new-password" required minlength="8" @bind="_newPassword" class="@Classes.Input" />
        </label>
        <label class="@Classes.Field">
            <span class="@Classes.LabelText">Confirm new password</span>
            <input name="ConfirmPassword" type="password" autocomplete="new-password" required minlength="8" @bind="_confirmPassword" class="@Classes.Input" />
        </label>
        <button type="submit" disabled="@_saving" class="@Classes.SubmitButton">@(_saving ? "Changing..." : "Change password")</button>
    </form>
</div>

@code {
    [Parameter]
    public string? InitialError { get; set; }

    [Parameter]
    public string? InitialSuccess { get; set; }

    [Parameter]
    public StorefrontAccountPasswordActionDescriptor Actions { get; set; } = StorefrontAccountPasswordActionDescriptor.Empty;

    [Parameter]
    public StorefrontAccountFormClasses Classes { get; set; } = StorefrontAccountFormClasses.Empty;

    [Parameter]
    public string? AntiforgeryFieldName { get; set; }

    [Parameter]
    public string? AntiforgeryRequestToken { get; set; }

    [Parameter]
    public StorefrontFeatureDataMode DataMode { get; set; } = StorefrontFeatureDataMode.BrowserFetch;

    private string? _currentPassword;
    private string? _newPassword;
    private string? _confirmPassword;
    private string? _error;
    private string? _success;
    private bool _saving;

    protected override void OnParametersSet()
    {
        _error = InitialError;
        _success = InitialSuccess;
    }

    private async Task SaveAsync()
    {
        if (!OperatingSystem.IsBrowser())
        {
            return;
        }

        var apiClient = Services.GetService(typeof(StorefrontLocalApiClient)) as StorefrontLocalApiClient;
        if (apiClient is null)
        {
            return;
        }

        _saving = true;
        _error = null;
        _success = null;
        if (!string.Equals(_newPassword, _confirmPassword, StringComparison.Ordinal))
        {
            _saving = false;
            _error = "Passwords do not match.";
            return;
        }

        var result = await apiClient.PostJsonAsync<object, StorefrontBrowserAccountCommandResult>(
            Actions.ChangePasswordRoute,
            new
            {
                CurrentPassword = _currentPassword,
                NewPassword = _newPassword,
                ConfirmPassword = _confirmPassword,
            });
        _saving = false;
        if (result.Success && result.Data?.Success == true)
        {
            _currentPassword = null;
            _newPassword = null;
            _confirmPassword = null;
            _success = result.Data.Message;
            return;
        }

        _error = result.Message;
    }

    private RenderFragment RenderAntiforgeryField() => builder =>
    {
        if (string.IsNullOrWhiteSpace(AntiforgeryFieldName) || string.IsNullOrWhiteSpace(AntiforgeryRequestToken))
        {
            return;
        }

        builder.OpenElement(0, "input");
        builder.AddAttribute(1, "type", "hidden");
        builder.AddAttribute(2, "name", AntiforgeryFieldName);
        builder.AddAttribute(3, "value", AntiforgeryRequestToken);
        builder.CloseElement();
    };
}

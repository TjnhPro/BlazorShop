@using BlazorShop.Storefront.Components.Browser
@using BlazorShop.Storefront.Browser
@using BlazorShop.Storefront.Components.Headless.Checkout
@inject IServiceProvider Services
@inject NavigationManager NavigationManager

@if (ShowPanel)
{
    <section class="@Classes.Shell" data-storefront-checkout-shell>
        <div class="@Classes.HeaderLayout">
            <div>
                <p class="@Classes.Eyebrow">Checkout state</p>
                <h2 class="@Classes.Title">@Title</h2>
                @if (!string.IsNullOrWhiteSpace(_state.Message))
                {
                    <p class="@Classes.BodyText">@_state.Message</p>
                }
            </div>
            <button type="button" class="@Classes.RefreshButton" @onclick="RefreshAsync" disabled="@_loading">
                @(_loading ? "Refreshing..." : "Refresh")
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="@Classes.Error" role="alert">@_error</div>
        }

        @if (_state.HasCart)
        {
            <div class="@Classes.MetricsGrid">
                <div class="@Classes.MetricCard">
                    <p class="@Classes.Eyebrow">Cart version</p>
                    <p class="@Classes.MetricValue" data-storefront-checkout-cart-version>@_state.CartVersion</p>
                </div>
                <div class="@Classes.MetricCard">
                    <p class="@Classes.Eyebrow">Checkout version</p>
                    <p class="@Classes.MetricValue">@_state.CheckoutVersion</p>
                </div>
                <div class="@Classes.MetricCard">
                    <p class="@Classes.Eyebrow">Total</p>
                    <p class="@Classes.MetricValue">@_state.GrandTotalDisplay</p>
                </div>
            </div>

            @if (_state.Issues.Count > 0)
            {
                <div class="@Classes.IssuePanel">
                    @foreach (var issue in _state.Issues)
                    {
                        <p>@issue.Message</p>
                    }
                </div>
            }

            <div class="@Classes.OptionGrid">
                <section class="@Classes.OptionPanel">
                    <h3>Shipping</h3>
                    <div class="@Classes.OptionList">
                        @if (!_state.ShippingRequired)
                        {
                            <p>Shipping is not required for this cart.</p>
                        }
                        else if (_state.ShippingOptions.Count == 0)
                        {
                            <p>Shipping is not available yet.</p>
                        }
                        else
                        {
                            @foreach (var option in _state.ShippingOptions)
                            {
                                <label class="@Classes.OptionLabel">
                                    <input type="radio" name="wasmShippingOption" checked="@option.Selected" @onchange="() => SelectShippingAsync(option.Key)" />
                                    <span>
                                        <span>@option.DisplayName</span>
                                        @if (!string.IsNullOrWhiteSpace(option.AmountDisplay))
                                        {
                                            <span>@option.AmountDisplay</span>
                                        }
                                    </span>
                                </label>
                            }
                        }
                    </div>
                </section>

                <section class="@Classes.OptionPanel">
                    <h3>Payment</h3>
                    <div class="@Classes.OptionList">
                        @foreach (var method in _state.PaymentMethods)
                        {
                            <label class="@Classes.OptionLabel">
                                <input type="radio" name="wasmPaymentMethod" checked="@method.Selected" @onchange="() => SelectPaymentAsync(method.Key)" />
                                <span>
                                    <span>@method.DisplayName</span>
                                    @if (!string.IsNullOrWhiteSpace(method.Description))
                                    {
                                        <span>@method.Description</span>
                                    }
                                </span>
                            </label>
                        }
                    </div>
                </section>
            </div>

            <button type="button" class="@Classes.PrimaryButton" @onclick="ReviewAsync" disabled="@_loading">
                Review latest checkout
            </button>
            @if (_state.PlaceOrderAllowed)
            {
                <button type="button" class="@Classes.SecondaryButton" @onclick="PlaceOrderAsync" disabled="@_loading">
                    Place order
                </button>
            }
        }
    </section>
}

@code {
    [Parameter]
    public StorefrontBrowserCheckoutState InitialState { get; set; } = EmptyState("Checkout is not available yet.");

    [Parameter]
    public bool ShowPanel { get; set; } = true;

    [Parameter]
    public StorefrontFeatureDataMode DataMode { get; set; } = StorefrontFeatureDataMode.BrowserFetch;

    [Parameter]
    public StorefrontCheckoutActionDescriptor Actions { get; set; } = StorefrontCheckoutActionDescriptor.Empty;

    [Parameter]
    public StorefrontCheckoutViewClasses Classes { get; set; } = StorefrontCheckoutViewClasses.Empty;

    private StorefrontBrowserCheckoutState _state = EmptyState("Checkout is not available yet.");
    private string? _error;
    private bool _loading;
    private string _idempotencyKey = Guid.NewGuid().ToString("N");

    private string Title => !_state.HasCart ? "Cart is empty" : $"{_state.CurrentStep} ready";

    private StorefrontCheckoutViewState ViewState => StorefrontCheckoutViewState.FromState(_state, _loading, _error);

    protected override void OnParametersSet()
    {
        _state = InitialState;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ShowPanel
            && firstRender
            && OperatingSystem.IsBrowser()
            && DataMode != StorefrontFeatureDataMode.InitialSnapshot)
        {
            await RefreshAsync();
        }
    }

    private async Task RefreshAsync()
    {
        if (!ShowPanel || string.IsNullOrWhiteSpace(Actions.CurrentCheckoutRoute))
        {
            return;
        }

        await LoadAsync(client => client.GetAsync<StorefrontBrowserCheckoutState>(Actions.CurrentCheckoutRoute));
    }

    private async Task SelectShippingAsync(string key)
    {
        if (_state.CheckoutSessionId is not { } sessionId)
        {
            return;
        }

        await LoadAsync(client => client.PostJsonAsync<StorefrontBrowserCheckoutSelectionRequest, StorefrontBrowserCheckoutState>(
            Actions.ShippingMethodRoute,
            new StorefrontBrowserCheckoutSelectionRequest
            {
                CheckoutSessionId = sessionId,
                ExpectedCartVersion = _state.CartVersion,
                Key = key,
            }));
    }

    private async Task SelectPaymentAsync(string key)
    {
        if (_state.CheckoutSessionId is not { } sessionId)
        {
            return;
        }

        await LoadAsync(client => client.PostJsonAsync<StorefrontBrowserCheckoutSelectionRequest, StorefrontBrowserCheckoutState>(
            Actions.PaymentMethodRoute,
            new StorefrontBrowserCheckoutSelectionRequest
            {
                CheckoutSessionId = sessionId,
                ExpectedCartVersion = _state.CartVersion,
                Key = key,
            }));
    }

    private async Task ReviewAsync()
    {
        if (_state.CheckoutSessionId is not { } sessionId)
        {
            return;
        }

        await LoadAsync(client => client.PostJsonAsync<StorefrontBrowserCheckoutReviewRequest, StorefrontBrowserCheckoutState>(
            Actions.ReviewRoute,
            new StorefrontBrowserCheckoutReviewRequest
            {
                CheckoutSessionId = sessionId,
                ExpectedCartVersion = _state.CartVersion,
                TermsAccepted = true,
            }));
    }

    private async Task PlaceOrderAsync()
    {
        if (_state.CheckoutSessionId is not { } sessionId)
        {
            return;
        }

        var apiClient = Services.GetService(typeof(StorefrontLocalApiClient)) as StorefrontLocalApiClient;
        if (apiClient is null)
        {
            return;
        }

        _loading = true;
        _error = null;
        var result = await apiClient.PostJsonAsync<StorefrontBrowserCheckoutPlaceOrderRequest, StorefrontBrowserCheckoutPlaceOrderResult>(
            Actions.PlaceOrderRoute,
            new StorefrontBrowserCheckoutPlaceOrderRequest
            {
                CheckoutSessionId = sessionId,
                ExpectedCheckoutVersion = _state.CheckoutVersion,
                ExpectedCartVersion = _state.CartVersion,
                IdempotencyKey = _idempotencyKey,
            });
        _loading = false;
        if (!result.Success || result.Data is null)
        {
            _error = result.Message;
            return;
        }

        if (!string.IsNullOrWhiteSpace(result.Data.RedirectUrl))
        {
            NavigationManager.NavigateTo(result.Data.RedirectUrl, forceLoad: true);
        }
    }

    private async Task LoadAsync(Func<StorefrontLocalApiClient, Task<StorefrontLocalApiResult<StorefrontBrowserCheckoutState>>> action)
    {
        var apiClient = Services.GetService(typeof(StorefrontLocalApiClient)) as StorefrontLocalApiClient;
        if (apiClient is null)
        {
            return;
        }

        _loading = true;
        _error = null;
        var result = await action(apiClient);
        _loading = false;
        if (result.Success && result.Data is not null)
        {
            _state = result.Data;
            return;
        }

        _error = result.Message;
    }

    private static StorefrontBrowserCheckoutState EmptyState(string message)
    {
        return new StorefrontBrowserCheckoutState(
            false,
            message,
            null,
            0,
            0,
            "empty",
            "cart",
            false,
            false,
            false,
            string.Empty,
            [],
            [],
            [],
            []);
    }
}

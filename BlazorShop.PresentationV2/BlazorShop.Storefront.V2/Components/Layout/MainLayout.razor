@using BlazorShop.Storefront.Presentation.Contracts

@inherits LayoutComponentBase

<div class="bs-storefront-shell">
    <StorefrontHeader Context="Context.Header" />

    <div data-storefront-toast-region
         class="pointer-events-none fixed inset-x-0 top-4 z-[100] flex justify-end px-4 sm:px-6 lg:px-8"
         aria-live="polite"
         aria-atomic="true"></div>
    <template data-storefront-toast-template>
        <div data-storefront-toast
             data-level="info"
             data-state="entering"
             class="bs-storefront-toast pointer-events-auto w-full max-w-sm overflow-hidden rounded-2xl border border-white/10 text-white shadow-2xl ring-1 ring-black/10">
            <div class="flex items-start gap-3 px-4 py-3">
                <div data-storefront-toast-accent class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-full">
                    <svg data-storefront-toast-icon="info" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
                        <circle cx="12" cy="12" r="10" />
                        <path d="M12 16v-4" />
                        <path d="M12 8h.01" />
                    </svg>
                    <svg data-storefront-toast-icon="success" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
                        <path d="m5 13 4 4L19 7" />
                    </svg>
                    <svg data-storefront-toast-icon="warning" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
                        <path d="M12 9v4" />
                        <path d="M12 17h.01" />
                        <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" />
                    </svg>
                    <svg data-storefront-toast-icon="error" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
                        <circle cx="12" cy="12" r="10" />
                        <path d="m15 9-6 6" />
                        <path d="m9 9 6 6" />
                    </svg>
                </div>
                <div class="min-w-0 flex-1">
                    <p data-storefront-toast-heading class="text-sm font-semibold leading-5"></p>
                    <p data-storefront-toast-message class="mt-1 text-sm leading-5 text-white/85"></p>
                </div>
                <button type="button"
                        data-storefront-toast-close
                        class="rounded-full border border-white/10 bg-white/5 p-1 text-white/70 transition hover:bg-white/10 hover:text-white"
                        aria-label="Dismiss notification">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M6 6l12 12" /><path d="m18 6-12 12" /></svg>
                </button>
            </div>
        </div>
    </template>

    <main class="bs-storefront-main flex-1">
        @Body
    </main>

    <StorefrontFooter Context="Context.Footer" />
</div>

@code {
    [Parameter, EditorRequired]
    public StorefrontShellContext Context { get; set; } = default!;
}

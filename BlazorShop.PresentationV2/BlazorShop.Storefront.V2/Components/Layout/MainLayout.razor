@using BlazorShop.Storefront.Presentation.Contracts

@inherits LayoutComponentBase

<div class="bs-storefront-shell">
    <StorefrontHeader Context="Context.Header" />

    <StorefrontToastRegion Classes="StorefrontToastVisuals.Classes" Labels="StorefrontToastVisuals.Labels" />

    <main class="bs-storefront-main flex-1">
        @Body
    </main>

    <StorefrontFooter Context="Context.Footer" />
</div>

@code {
    [Parameter, EditorRequired]
    public StorefrontShellContext Context { get; set; } = default!;
}

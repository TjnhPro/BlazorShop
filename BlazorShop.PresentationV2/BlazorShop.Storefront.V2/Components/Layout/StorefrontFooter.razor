@using BlazorShop.Storefront.Services.Contracts

<footer class="border-t border-white/10 bg-neutral-900 text-neutral-100">
    <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
            <div>
                <div class="text-lg font-extrabold tracking-wider">@Context.Brand.Name</div>
                <p class="mt-1 text-sm text-neutral-300">@Context.Brand.Label</p>
                <p class="mt-3 text-sm leading-6 text-neutral-400">@BrandDescription</p>
            </div>

            <div>
                <div class="text-sm font-semibold uppercase text-neutral-300">Shop</div>
                <ul class="mt-3 space-y-2 text-sm text-neutral-300">
                    @if (Context.Navigation.FooterCompanyMenu is not null)
                    {
                        @foreach (var item in Context.Navigation.FooterCompanyMenu.Links)
                        {
                            <li><a href="@item.Href" target="@item.Target" class="hover:text-white/80">@item.Label</a></li>
                        }
                    }
                    else
                    {
                        <li><a href="@Context.Links.Home.Href" class="hover:text-white/80">@Context.Links.Home.Label</a></li>
                        <li><a href="@Context.Links.NewReleases.Href" class="hover:text-white/80">@Context.Links.NewReleases.Label</a></li>
                        <li><a href="@Context.Links.TodaysDeals.Href" class="hover:text-white/80">@Context.Links.TodaysDeals.Label</a></li>
                        @foreach (var link in Context.Navigation.FooterCompanyLinks)
                        {
                            <li><a href="@link.Href" target="@link.Target" class="hover:text-white/80">@link.Label</a></li>
                        }
                    }
                </ul>
            </div>

            <div>
                <div class="text-sm font-semibold uppercase text-neutral-300">Support</div>
                <ul class="mt-3 space-y-2 text-sm text-neutral-300">
                    @if (Context.Navigation.FooterSupportMenu is not null)
                    {
                        @foreach (var item in Context.Navigation.FooterSupportMenu.Links)
                        {
                            <li><a href="@item.Href" target="@item.Target" class="hover:text-white/80">@item.Label</a></li>
                        }
                    }
                    else
                    {
                        @foreach (var link in Context.Navigation.FooterSupportLinks)
                        {
                            <li><a href="@link.Href" target="@link.Target" class="hover:text-white/80">@link.Label</a></li>
                        }
                    }
                </ul>
            </div>

            <div>
                <div class="text-sm font-semibold uppercase text-neutral-300">Contact</div>
                @if (HasContactDetails)
                {
                    <ul class="mt-3 space-y-2 text-sm leading-6 text-neutral-300">
                        @if (!string.IsNullOrWhiteSpace(Context.ContactEmail))
                        {
                            <li><a href="mailto:@Context.ContactEmail" class="hover:text-white/80">@Context.ContactEmail</a></li>
                        }
                        @if (!string.IsNullOrWhiteSpace(Context.ContactPhone))
                        {
                            <li><a href="@Context.ContactPhoneHref" class="hover:text-white/80">@Context.ContactPhone</a></li>
                        }
                        @if (!string.IsNullOrWhiteSpace(Context.CompanyAddress))
                        {
                            <li class="text-neutral-400">@Context.CompanyAddress</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="mt-3 text-sm leading-6 text-neutral-400">Visit customer service for store support and order questions.</p>
                }
                <div class="mt-4 flex flex-wrap gap-3">
                    <a href="@Context.Links.NewReleases.Href" class="inline-flex items-center rounded bg-neutral-100 px-3 py-2 text-sm font-semibold text-neutral-900 hover:bg-white">Shop New</a>
                    <a href="@Context.Links.TodaysDeals.Href" class="inline-flex items-center rounded bg-amber-500 px-3 py-2 text-sm font-semibold text-white hover:bg-amber-600">View Deals</a>
                </div>
            </div>
        </div>

        <div class="mt-8 border-t border-white/10 pt-4 text-xs text-neutral-400 sm:flex sm:items-center sm:justify-between">
            <p>@Context.CopyrightLabel</p>
            <div class="mt-3 flex justify-center gap-4 sm:mt-0">
                @if (Context.Navigation.FooterLegalMenu is not null)
                {
                    @foreach (var item in Context.Navigation.FooterLegalMenu.Links)
                    {
                        <a href="@item.Href" target="@item.Target" class="hover:text-white/80">@item.Label</a>
                    }
                }
                else
                {
                    @foreach (var link in Context.Navigation.FooterLegalLinks)
                    {
                        <a href="@link.Href" target="@link.Target" class="hover:text-white/80">@link.Label</a>
                    }
                }
                <button type="button" data-storefront-consent-manage class="hover:text-white/80">Privacy choices</button>
            </div>
        </div>
    </div>
</footer>

@code {
    [Parameter, EditorRequired]
    public StorefrontFooterContext Context { get; set; } = default!;

    private string BrandDescription => !string.IsNullOrWhiteSpace(Context.CompanyAddress)
        ? $"Products and support from {Context.Brand.Name}."
        : "Quality products, fair prices, and route-based public shopping pages.";

    private bool HasContactDetails => !string.IsNullOrWhiteSpace(Context.ContactEmail)
        || !string.IsNullOrWhiteSpace(Context.ContactPhone)
        || !string.IsNullOrWhiteSpace(Context.CompanyAddress);
}

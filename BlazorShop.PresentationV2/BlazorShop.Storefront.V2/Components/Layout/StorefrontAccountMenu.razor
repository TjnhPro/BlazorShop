@using BlazorShop.Storefront.Services.Contracts

<details class="bs-storefront-account-menu">
    <summary class="bs-storefront-icon-button bs-storefront-account-menu__summary" aria-label="Account menu" title="Account">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M6 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/></svg>
    </summary>

    <div class="bs-storefront-account-menu__panel">
        @if (Context.IsAuthenticated)
        {
            <div class="bs-storefront-account-menu__intro">
                <div class="bs-storefront-account-menu__title">@(Context.DisplayName ?? "Signed in")</div>
                @if (!string.IsNullOrWhiteSpace(Context.Email))
                {
                    <div class="bs-storefront-account-menu__meta">@Context.Email</div>
                }
            </div>

            <div class="bs-storefront-account-menu__links">
                @foreach (var link in Context.Links)
                {
                    <a href="@link.Href" target="@link.Target" class="bs-storefront-account-menu__link">@link.Label</a>
                }
                <StorefrontLogoutForm Context="Context" SubmitClass="bs-storefront-account-menu__link bs-storefront-account-menu__button">
                    Sign out
                </StorefrontLogoutForm>
            </div>
        }
        else
        {
            <div class="bs-storefront-account-menu__intro">
                <div class="bs-storefront-account-menu__title">Account access</div>
                <div class="bs-storefront-account-menu__meta">Sign in for your customer workspace, or register before you continue to checkout.</div>
            </div>

            <div class="bs-storefront-account-menu__links">
                @foreach (var link in Context.Links)
                {
                    <a href="@link.Href" target="@link.Target" class="bs-storefront-account-menu__link">@link.Label</a>
                }
            </div>
        }
    </div>
</details>

@code {
    [Parameter, EditorRequired]
    public StorefrontAccountMenuContext Context { get; set; } = default!;
}

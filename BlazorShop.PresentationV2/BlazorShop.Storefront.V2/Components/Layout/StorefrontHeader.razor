@using BlazorShop.Storefront.Presentation.Contracts

<header class="bs-storefront-header relative text-neutral-100">
    <div class="bs-storefront-header__shell">
        <div class="bs-storefront-header__desktop relative mx-auto max-w-7xl px-4 py-4 sm:px-6 lg:px-8">
            <a href="@Context.Links.Home.Href" class="bs-storefront-header__brand" aria-label="@Context.Brand.HomeLabel">
                @if (!string.IsNullOrWhiteSpace(Context.Brand.LogoUrl))
                {
                    <img class="bs-storefront-header__brand-logo" src="@Context.Brand.LogoUrl" alt="" loading="eager" decoding="async" />
                }
                <span class="bs-storefront-header__brand-mark">@Context.Brand.Name</span>
                <span class="bs-storefront-header__brand-label">@Context.Brand.Label</span>
            </a>

            <form method="get" action="@Context.Search.Action" class="bs-storefront-search" role="search">
                <select name="category" class="bs-storefront-search__select" aria-label="Search category">
                    <option value="">All</option>
                    @foreach (var category in Context.Search.Categories)
                    {
                        <option value="@category.Href">@category.Label</option>
                    }
                </select>
                <input name="q" class="bs-storefront-search__input" type="search" placeholder="Search products" aria-label="Search products" autocomplete="off" />
                <button type="submit" class="bs-storefront-search__button" aria-label="Search">
                    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                    <span class="bs-storefront-search__button-text">Search</span>
                </button>
            </form>

            <nav class="bs-storefront-header__desktop-nav flex flex-wrap items-center gap-2 text-sm font-medium lg:justify-center" aria-label="Primary shop navigation">
                @if (Context.Navigation.MainMenu is not null)
                {
                    @foreach (var item in Context.Navigation.MainMenu.Links)
                    {
                        <NavLink href="@item.Href" target="@item.Target" class="bs-storefront-nav-link" ActiveClass="is-active">@item.Label</NavLink>
                    }
                }
                else
                {
                    <NavLink href="@Context.Links.Home.Href" Match="NavLinkMatch.All" class="bs-storefront-nav-link" ActiveClass="is-active">@Context.Links.Home.Label</NavLink>
                    <NavLink href="@Context.Links.Search.Href" class="bs-storefront-nav-link" ActiveClass="is-active">@Context.Links.Search.Label</NavLink>
                    @foreach (var link in Context.Navigation.HeaderLinks)
                    {
                        <NavLink href="@link.Href" target="@link.Target" class="bs-storefront-nav-link" ActiveClass="is-active">@link.Label</NavLink>
                    }
                }
            </nav>

            <div class="bs-storefront-header__desktop-actions flex shrink-0 flex-wrap items-center gap-3 text-sm" aria-label="Shop actions">
                @if (Context.Currency.ShowSelector)
                {
                    <StorefrontCurrencyPreferenceForm Context="Context.Currency"
                                                      FormClass="bs-storefront-currency-form"
                                                      SelectClass="bs-storefront-currency-select"
                                                      SubmitClass="bs-storefront-currency-submit">
                        <SubmitContent>
                            <i class="fa-solid fa-check" aria-hidden="true"></i>
                        </SubmitContent>
                    </StorefrontCurrencyPreferenceForm>
                }
                <a href="@Context.Links.Cart.Href"
                   class="bs-storefront-icon-button"
                   aria-label="Open cart"
                   title="Open cart">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M6 6h15l-1.5 9h-12z" />
                        <path d="M6 6 5 3H3" />
                        <circle cx="9" cy="20" r="1" />
                        <circle cx="18" cy="20" r="1" />
                    </svg>
                    <span data-storefront-cart-badge hidden class="bs-storefront-cart-badge">0</span>
                </a>
                <StorefrontAccountMenu Context="Context.AccountMenu" />
                <a href="@Context.Links.Search.Href" class="bs-storefront-pill-button">@Context.Links.Search.Label</a>
            </div>
        </div>

        <div class="bs-storefront-header__mobile relative mx-auto max-w-7xl px-4 py-3 sm:px-6">
            <a href="@Context.Links.Home.Href" class="bs-storefront-header__brand" aria-label="@Context.Brand.HomeLabel">
                @if (!string.IsNullOrWhiteSpace(Context.Brand.LogoUrl))
                {
                    <img class="bs-storefront-header__brand-logo" src="@Context.Brand.LogoUrl" alt="" loading="eager" decoding="async" />
                }
                <span class="bs-storefront-header__brand-mark">@Context.Brand.Name</span>
                <span class="bs-storefront-header__brand-label">@Context.Brand.Label</span>
            </a>

            <div class="bs-storefront-header__mobile-actions" aria-label="Shop shortcuts">
                <a href="@Context.Links.Cart.Href"
                   class="bs-storefront-icon-button"
                   aria-label="Open cart"
                   title="Open cart">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M6 6h15l-1.5 9h-12z" />
                        <path d="M6 6 5 3H3" />
                        <circle cx="9" cy="20" r="1" />
                        <circle cx="18" cy="20" r="1" />
                    </svg>
                    <span data-storefront-cart-badge hidden class="bs-storefront-cart-badge">0</span>
                </a>
                <StorefrontAccountMenu Context="Context.AccountMenu" />
            </div>

            <form method="get" action="@Context.Search.Action" class="bs-storefront-search bs-storefront-search--mobile" role="search">
                <select name="category" class="bs-storefront-search__select" aria-label="Search category">
                    <option value="">All</option>
                    @foreach (var category in Context.Search.Categories)
                    {
                        <option value="@category.Href">@category.Label</option>
                    }
                </select>
                <input name="q" class="bs-storefront-search__input" type="search" placeholder="Search products" aria-label="Search products" autocomplete="off" />
                <button type="submit" class="bs-storefront-search__button" aria-label="Search">
                    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                    <span class="bs-storefront-search__button-text">Search</span>
                </button>
            </form>

            <details class="bs-storefront-header__menu">
                <summary class="bs-storefront-menu-button" aria-label="Open shop navigation">
                    <span class="bs-storefront-menu-button__text">Menu</span>
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 7h16M4 12h16M4 17h16" />
                    </svg>
                </summary>

                <div class="bs-storefront-header__mobile-panel">
                    <nav class="bs-storefront-header__mobile-nav" aria-label="Mobile shop navigation">
                        @if (Context.Navigation.MainMenu is not null)
                        {
                            @foreach (var item in Context.Navigation.MainMenu.Links)
                            {
                                <NavLink href="@item.Href" target="@item.Target" class="bs-storefront-nav-link" ActiveClass="is-active">@item.Label</NavLink>
                            }
                        }
                        else
                        {
                            <NavLink href="@Context.Links.Home.Href" Match="NavLinkMatch.All" class="bs-storefront-nav-link" ActiveClass="is-active">@Context.Links.Home.Label</NavLink>
                            <NavLink href="@Context.Links.Search.Href" class="bs-storefront-nav-link" ActiveClass="is-active">@Context.Links.Search.Label</NavLink>
                            @foreach (var link in Context.Navigation.HeaderLinks)
                            {
                                <NavLink href="@link.Href" target="@link.Target" class="bs-storefront-nav-link" ActiveClass="is-active">@link.Label</NavLink>
                            }
                        }
                    </nav>

                    <div class="bs-storefront-header__mobile-panel-actions">
                        @if (Context.Currency.ShowSelector)
                        {
                            <StorefrontCurrencyPreferenceForm Context="Context.Currency"
                                                              FormClass="bs-storefront-currency-form bs-storefront-currency-form--mobile"
                                                              SelectClass="bs-storefront-currency-select"
                                                              SubmitClass="bs-storefront-currency-submit">
                                <SubmitContent>
                                    <i class="fa-solid fa-check" aria-hidden="true"></i>
                                </SubmitContent>
                            </StorefrontCurrencyPreferenceForm>
                        }
                        <a href="@Context.Links.Search.Href" class="bs-storefront-pill-button">@Context.Links.Search.Label</a>
                    </div>
                </div>
            </details>
        </div>
    </div>
</header>

@code {
    [Parameter, EditorRequired]
    public StorefrontHeaderContext Context { get; set; } = default!;
}

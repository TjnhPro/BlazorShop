@using BlazorShop.Storefront.Components.Browser
@using BlazorShop.Storefront.Components.Headless.Cart
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IServiceProvider Services
@inject IJSRuntime JS

<section class="@Classes.PageSection">
    <div class="@Classes.Layout">
        <div class="@Classes.ContentColumn">
            <header class="@Classes.HeaderCard">
                <div class="@Classes.HeaderLayout">
                    <div>
                        <p class="@Classes.Eyebrow">Storefront Cart</p>
                        <h1 class="@Classes.PageTitle">My Cart</h1>
                        <p class="@Classes.BodyText">Review the items you picked from the public storefront before you continue to checkout.</p>
                    </div>

                    <div class="@Classes.CountBadge">
                        @ViewState.ItemCount item@(ViewState.ItemCount == 1 ? string.Empty : "s") in cart
                    </div>
                </div>
            </header>

            @foreach (var alert in Alerts)
            {
                <div class="@AlertClass(alert)">
                    @alert.Message
                </div>
            }

            @if (Lines.Count == 0)
            {
                <div class="@Classes.EmptyState">
                    <h2 class="@Classes.EmptyTitle">Your cart is empty</h2>
                    <p class="@Classes.BodyText">Add products from the storefront and they will appear here for review before checkout.</p>
                    <div class="@Classes.EmptyActions">
                        <a href="@NewReleasesUrl" class="@Classes.PrimaryLink">Shop New Releases</a>
                        <a href="@TodaysDealsUrl" class="@Classes.SecondaryLink">See Today's Deals</a>
                    </div>
                </div>
            }
            else
            {
                <div class="@Classes.LineList">
                    @foreach (var line in Lines)
                    {
                        <article class="@Classes.LineCard">
                            <div class="@Classes.LineLayout">
                                <div class="@Classes.LineImageFrame">
                                    @if (!string.IsNullOrWhiteSpace(line.ImageUrl))
                                    {
                                        <img src="@line.ImageUrl" alt="@line.DisplayName" class="@Classes.LineImage" />
                                    }
                                    else
                                    {
                                        <span>Item</span>
                                    }
                                </div>

                                <div>
                                    @if (!string.IsNullOrWhiteSpace(line.ProductUrl))
                                    {
                                        <a href="@line.ProductUrl" class="@Classes.LineTitle">@line.DisplayName</a>
                                    }
                                    else
                                    {
                                        <h2 class="@Classes.LineTitle">@line.DisplayName</h2>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(line.VariantLabel))
                                    {
                                        <p class="@Classes.LineMeta">@line.VariantLabel</p>
                                    }

                                    @foreach (var warning in line.Warnings)
                                    {
                                        <p class="@Classes.LineWarning">@warning.Message</p>
                                    }

                                    <div class="@Classes.LineControls">
                                        <div class="@Classes.LineMetrics">
                                            <div>
                                                <p class="@Classes.MetricLabel">Unit Price</p>
                                                <p class="@Classes.MetricValue">@line.UnitPriceDisplay</p>
                                            </div>

                                            <label>
                                                <span class="@Classes.MetricLabel">Quantity</span>
                                                <input type="number"
                                                       min="@line.QuantityMinimum"
                                                       max="@line.QuantityMaximum"
                                                       step="@line.QuantityStep"
                                                       value="@line.Quantity"
                                                       disabled="@IsDisabled(line.LineId)"
                                                       data-storefront-cart-quantity
                                                       data-line-id="@line.LineId"
                                                       data-product-id="@line.ProductId"
                                                       data-variant-id="@line.ProductVariantId"
                                                       data-product-name="@line.DisplayName"
                                                       data-size-value="@line.VariantLabel"
                                                       @onchange="eventArgs => UpdateQuantityAsync(line, eventArgs.Value)"
                                                       class="@Classes.QuantityInput" />
                                            </label>

                                            <div>
                                                <p class="@Classes.MetricLabel">Line Total</p>
                                                <p class="@Classes.MetricValue">@line.LineTotalDisplay</p>
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(line.ProductUrl))
                                        {
                                            <a href="@line.ProductUrl" class="@Classes.PrimaryLink">View Product</a>
                                        }

                                        <button type="button"
                                                disabled="@IsDisabled(line.LineId)"
                                                data-storefront-cart-remove
                                                data-line-id="@line.LineId"
                                                data-product-id="@line.ProductId"
                                                data-variant-id="@line.ProductVariantId"
                                                data-product-name="@line.DisplayName"
                                                data-size-value="@line.VariantLabel"
                                                @onclick="() => RemoveLineAsync(line)"
                                                class="@Classes.RemoveButton">
                                            Remove
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>

        <aside class="@Classes.SummaryAside">
            <div class="@Classes.SummaryCard">
                <p class="@Classes.Eyebrow">Order Summary</p>
                <h2 class="@Classes.EmptyTitle">Ready for checkout</h2>

                <dl class="@Classes.SummaryRows">
                    <div class="@Classes.SummaryRow">
                        <dt>Items</dt>
                        <dd>@ViewState.ItemCount</dd>
                    </div>
                    <div class="@Classes.SummaryRow">
                        <dt>Subtotal</dt>
                        <dd>@GrandTotalDisplay</dd>
                    </div>
                    <div class="@Classes.SummaryRow">
                        <dt>Total</dt>
                        <dd>@GrandTotalDisplay</dd>
                    </div>
                </dl>

                <div>
                    @if (Lines.Count > 0)
                    {
                        @if (ViewState.CheckoutAllowed)
                        {
                            <a href="@CheckoutUrl" class="@Classes.CheckoutButton">Continue to Checkout</a>
                        }
                        else
                        {
                            <button type="button" disabled class="@Classes.DisabledCheckoutButton">Continue to Checkout</button>
                        }
                        <p class="@Classes.BodyText">Checkout continues through an authenticated handoff so payment and order history stay attached to your profile.</p>

                        <button type="button"
                                disabled="@(_apiClient is null || _clearing || _busyLineId.HasValue)"
                                data-storefront-cart-clear
                                @onclick="ClearCartAsync"
                                class="@Classes.ClearButton">
                            Clear Cart
                        </button>
                    }

                    <a href="@NewReleasesUrl" class="@Classes.PrimaryLink">Keep Shopping</a>
                </div>
            </div>
        </aside>
    </div>
</section>

@code {
    private StorefrontBrowserCart? _cart;
    private List<StorefrontBrowserCartAlert> _alerts = [];
    private StorefrontLocalApiClient? _apiClient;
    private Lazy<Task<IJSObjectReference>>? _moduleTask;
    private Guid? _busyLineId;
    private bool _clearing;

    [Parameter]
    public StorefrontBrowserCart? InitialCart { get; set; }

    [Parameter]
    public IReadOnlyList<StorefrontBrowserCartAlert> InitialAlerts { get; set; } = [];

    [Parameter]
    public StorefrontFeatureDataMode DataMode { get; set; } = StorefrontFeatureDataMode.BrowserFetch;

    [Parameter]
    public StorefrontCartActionDescriptor Actions { get; set; } = StorefrontCartActionDescriptor.Empty;

    [Parameter]
    public StorefrontCartViewClasses Classes { get; set; } = StorefrontCartViewClasses.Empty;

    [Parameter]
    public string CheckoutUrl { get; set; } = "/checkout";

    [Parameter]
    public string NewReleasesUrl { get; set; } = "/new-releases";

    [Parameter]
    public string TodaysDealsUrl { get; set; } = "/todays-deals";

    private IReadOnlyList<StorefrontBrowserCartAlert> Alerts => _alerts;

    private IReadOnlyList<StorefrontBrowserCartLine> Lines => _cart?.Lines ?? [];

    private string GrandTotalDisplay => _cart?.GrandTotalDisplay ?? "$0.00";

    private StorefrontCartViewState ViewState => StorefrontCartViewState.FromCart(_cart, _alerts);

    protected override void OnParametersSet()
    {
        _cart ??= InitialCart;
        if (_alerts.Count == 0 && InitialAlerts.Count > 0)
        {
            _alerts = [.. InitialAlerts];
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !OperatingSystem.IsBrowser())
        {
            return;
        }

        _apiClient = Services.GetService(typeof(StorefrontLocalApiClient)) as StorefrontLocalApiClient;
        if (_apiClient is not null)
        {
            _moduleTask = new Lazy<Task<IJSObjectReference>>(() =>
                JS.InvokeAsync<IJSObjectReference>(
                    "import",
                    "./js/storefrontWasmInterop.js").AsTask());
            if (ShouldFetchAfterHydration())
            {
                await LoadCartAsync();
            }
            else if (_cart is not null)
            {
                await PublishCartChangedAsync(_cart.Count);
            }

            StateHasChanged();
        }
    }

    private bool ShouldFetchAfterHydration()
    {
        return DataMode switch
        {
            StorefrontFeatureDataMode.InitialSnapshot => false,
            StorefrontFeatureDataMode.BrowserFetch => _cart is null,
            StorefrontFeatureDataMode.RefreshAfterHydration => true,
            _ => _cart is null
        };
    }

    private async Task LoadCartAsync()
    {
        if (_apiClient is null || string.IsNullOrWhiteSpace(Actions.CurrentCartRoute))
        {
            return;
        }

        var result = await _apiClient.GetAsync<StorefrontBrowserCart>(Actions.CurrentCartRoute);
        await ApplyCartResultAsync(result);
    }

    private async Task UpdateQuantityAsync(StorefrontBrowserCartLine line, object? value)
    {
        if (_apiClient is null
            || IsMutationBusy(line.LineId)
            || !Lines.Any(candidate => candidate.LineId == line.LineId)
            || !int.TryParse(Convert.ToString(value), out var quantity))
        {
            return;
        }

        if (quantity < line.QuantityMinimum)
        {
            AddError($"Minimum quantity for {line.DisplayName} is {line.QuantityMinimum}.");
            return;
        }

        _busyLineId = line.LineId;
        try
        {
            var result = await _apiClient.PutJsonAsync<StorefrontBrowserCartQuantityRequest, StorefrontBrowserCart>(
                Actions.UpdateLineRoute(line.LineId),
                new StorefrontBrowserCartQuantityRequest(quantity));
            await ApplyCartResultAsync(result);
        }
        finally
        {
            _busyLineId = null;
        }
    }

    private async Task RemoveLineAsync(StorefrontBrowserCartLine line)
    {
        if (_apiClient is null
            || IsMutationBusy(line.LineId)
            || !Lines.Any(candidate => candidate.LineId == line.LineId))
        {
            return;
        }

        _busyLineId = line.LineId;
        try
        {
            var result = await _apiClient.DeleteAsync<StorefrontBrowserCart>(Actions.RemoveLineRoute(line.LineId));
            await ApplyCartResultAsync(result);
        }
        finally
        {
            _busyLineId = null;
        }
    }

    private async Task ClearCartAsync()
    {
        if (_apiClient is null || _clearing || _busyLineId.HasValue || string.IsNullOrWhiteSpace(Actions.ClearCartRoute))
        {
            return;
        }

        _clearing = true;
        try
        {
            var result = await _apiClient.DeleteAsync<StorefrontBrowserCart>(Actions.ClearCartRoute);
            await ApplyCartResultAsync(result);
        }
        finally
        {
            _clearing = false;
        }
    }

    private bool IsBusy(Guid lineId) => _busyLineId == lineId || _clearing;

    private bool IsDisabled(Guid lineId) => _apiClient is null || IsBusy(lineId);

    private bool IsMutationBusy(Guid lineId) => _busyLineId.HasValue || _clearing || IsBusy(lineId);

    private async Task ApplyCartResultAsync(StorefrontLocalApiResult<StorefrontBrowserCart> result)
    {
        if (result.Success && result.Data is not null)
        {
            _cart = result.Data;
            _alerts = [.. result.Data.Warnings.Select(warning => new StorefrontBrowserCartAlert("warning", warning.Message))];
            await PublishCartChangedAsync(result.Data.Count);
            return;
        }

        AddError(string.IsNullOrWhiteSpace(result.Message) ? "Cart could not be updated." : result.Message);
    }

    private void AddError(string message)
    {
        _alerts.RemoveAll(alert => alert.Level == "error");
        _alerts.Insert(0, new StorefrontBrowserCartAlert("error", message));
    }

    private string AlertClass(StorefrontBrowserCartAlert alert)
    {
        return string.Join(
            " ",
            Classes.Alert,
            string.Equals(alert.Level, "error", StringComparison.OrdinalIgnoreCase) ? Classes.ErrorAlert : Classes.WarningAlert);
    }

    private async Task PublishCartChangedAsync(int count)
    {
        if (_moduleTask is null)
        {
            return;
        }

        var module = await _moduleTask.Value;
        await module.InvokeVoidAsync("publishCartChanged", count);
    }

    public async ValueTask DisposeAsync()
    {
        if (_moduleTask?.IsValueCreated != true)
        {
            return;
        }

        var module = await _moduleTask.Value;
        await module.DisposeAsync();
    }
}

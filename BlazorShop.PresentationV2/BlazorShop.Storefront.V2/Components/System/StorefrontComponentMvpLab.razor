@namespace BlazorShop.Storefront.V2.Components.System

<section class="bs-storefront-component-mvp" data-storefront-component-mvp>
    <header class="bs-storefront-component-mvp__header">
        <p class="bs-storefront-component-mvp__eyebrow">Architecture QA</p>
        <h1 class="bs-storefront-component-mvp__title">Storefront Component MVP</h1>
        <p class="bs-storefront-component-mvp__summary">Runtime proof for SSR, Hybrid, and WasmHost component boundaries.</p>
    </header>

    <div class="bs-storefront-component-mvp__grid">
        <section class="bs-storefront-component-mvp__section"
                 data-storefront-component-mvp-section="ssr">
            <p class="bs-storefront-component-mvp__section-label">SSR proof</p>
            <StorefrontBrandLogo Context="Context.BrandLogo" Classes="BrandLogoClasses" />
        </section>

        <section class="bs-storefront-component-mvp__section"
                 data-storefront-component-mvp-section="hybrid">
            <p class="bs-storefront-component-mvp__section-label">Hybrid proof</p>
            <p class="bs-storefront-component-mvp__placeholder" data-storefront-component-mvp-placeholder="hybrid">
                Hybrid runtime probe is ready for H2.4 and H2.5.
            </p>
        </section>

        <section class="bs-storefront-component-mvp__section"
                 data-storefront-component-mvp-section="wasmhost">
            <p class="bs-storefront-component-mvp__section-label">WasmHost proof</p>
            <p class="bs-storefront-component-mvp__placeholder" data-storefront-component-mvp-placeholder="wasmhost">
                WasmHost product rail proof is ready for H2.6.
            </p>
        </section>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public StorefrontComponentMvpPageContext Context { get; set; } = default!;

    private static StorefrontBrandLogoClasses BrandLogoClasses { get; } = new(
        Root: "bs-storefront-component-mvp__brand",
        Image: "bs-storefront-component-mvp__brand-image",
        Mark: "bs-storefront-component-mvp__brand-mark");
}

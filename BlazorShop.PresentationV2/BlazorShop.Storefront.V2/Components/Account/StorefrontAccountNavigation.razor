@using BlazorShop.Storefront.Components.Headless.Account

<nav class="@Classes.Nav" aria-label="Account navigation" data-storefront-account-navigation>
    @foreach (var item in Items)
    {
        <a class="@LinkClass(item.Href)" href="@item.Href" data-storefront-account-nav-item="@item.RouteKey">@item.Label</a>
    }
</nav>

@code {
    [Parameter]
    public string ActiveRoute { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<AccountNavigationItem> Items { get; set; } = [];

    [Parameter]
    public AccountNavigationClasses Classes { get; set; } = AccountNavigationClasses.Empty;

    private string LinkClass(string route)
    {
        var active = string.Equals(route, ActiveRoute, StringComparison.OrdinalIgnoreCase);
        return active ? Classes.ActiveLink : Classes.InactiveLink;
    }
}

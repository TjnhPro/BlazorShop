@namespace BlazorShop.Storefront.Pages.Ssr.System
@using BlazorShop.Storefront.Presentation.Services.System

<section class="mx-auto flex min-h-[70vh] max-w-5xl items-center px-4 py-16 sm:px-6 lg:px-8">
    <div class="w-full border-l-4 border-amber-500 bg-white px-6 py-8 shadow-sm sm:px-8">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-amber-700">@Context.Eyebrow</p>
        <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-neutral-950">@Context.Title</h1>
        <p class="mt-4 max-w-2xl text-base leading-7 text-neutral-700">@Context.Message</p>

        @if (!string.IsNullOrWhiteSpace(Context.Store?.SupportEmail) || !string.IsNullOrWhiteSpace(Context.Store?.SupportPhone))
        {
            <div class="mt-6 grid gap-2 text-sm text-neutral-700 sm:grid-cols-2">
                @if (!string.IsNullOrWhiteSpace(Context.Store?.SupportEmail))
                {
                    <a class="font-semibold text-neutral-900 underline-offset-4 hover:underline" href="mailto:@Context.Store.SupportEmail">@Context.Store.SupportEmail</a>
                }
                @if (!string.IsNullOrWhiteSpace(Context.Store?.SupportPhone))
                {
                    <a class="font-semibold text-neutral-900 underline-offset-4 hover:underline" href="tel:@Context.Store.SupportPhone">@Context.Store.SupportPhone</a>
                }
            </div>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public StorefrontSystemStateContext Context { get; set; } = default!;
}

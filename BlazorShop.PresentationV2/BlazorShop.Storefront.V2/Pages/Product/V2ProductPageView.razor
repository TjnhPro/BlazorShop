@namespace BlazorShop.Storefront.V2.Pages.Product
@using BlazorShop.Storefront.Components.Ssr.Navigation
@using BlazorShop.Storefront.Presentation.Models
@using BlazorShop.Storefront.Presentation.Services.Product
@using BlazorShop.Storefront.Presentation.Services

<StorefrontPageShell Class="mx-auto max-w-7xl px-4 pb-8 pt-10 sm:px-6 lg:px-8">
        <Breadcrumb>
            <StorefrontBreadcrumb Items="_breadcrumbs"
                                 Classes="CatalogNavigationVisuals.BreadcrumbClasses"
                                 Labels="CatalogNavigationVisuals.BreadcrumbLabels" />
        </Breadcrumb>

        <ChildContent>
            <div class="grid gap-8 lg:grid-cols-[1fr_1fr]">
                <div class="rounded-3xl border border-neutral-200/70 bg-white/90 p-6 shadow-lg">
                    <StorefrontProductGallery
                        Items="_galleryItems"
                        ProductName="@_product.Name"
                        Labels="ProductGalleryVisuals.Labels"
                        Classes="ProductGalleryVisuals.Classes" />
                </div>

                <div class="rounded-3xl border border-neutral-200/70 bg-white/90 p-8 shadow-lg">
                    @if (!string.IsNullOrWhiteSpace(_navigation.CategoryUrl))
                    {
                        <a href="@_navigation.CategoryUrl" class="text-sm font-semibold uppercase tracking-[0.2em] text-neutral-500 hover:text-neutral-900">@_navigation.CategoryName</a>
                    }
                    else if (!string.IsNullOrWhiteSpace(_navigation.CategoryName))
                    {
                        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-neutral-500">@_navigation.CategoryName</p>
                    }

                    @if (_badges.IsFreshArrival)
                    {
                        <div class="mt-4 flex flex-wrap items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.18em]">
                            <span class="inline-block rounded bg-green-600/90 px-2 py-0.5 text-white">New</span>
                        </div>
                    }

                    <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-neutral-900">@_product.Name</h1>
                    <StorefrontProductPricing
                        Model="_pricing"
                        Classes="ProductDetailDisplayVisuals.PricingClasses" />

                    <StorefrontProductAvailability
                        Availability="_availability"
                        Purchase="_purchase"
                        Classes="ProductDetailDisplayVisuals.AvailabilityClasses" />

                    <p class="mt-6 text-base leading-7 text-neutral-700">@_navigation.ProductDescription</p>

                <StorefrontProductPurchasePanel Model="_purchasePanel" Actions="Context.PurchaseActions" />

                <StorefrontProductVariantList
                    Items="_variants"
                    Labels="ProductDetailDisplayVisuals.VariantListLabels"
                    Classes="ProductDetailDisplayVisuals.VariantListClasses" />

                <div class="mt-8 flex flex-wrap gap-3">
                    @if (!string.IsNullOrWhiteSpace(_navigation.CategoryUrl) && !string.IsNullOrWhiteSpace(_navigation.CategoryName))
                    {
                        <a href="@_navigation.CategoryUrl" class="inline-flex items-center rounded bg-neutral-900 px-4 py-2 font-semibold text-white hover:bg-neutral-800">
                            Back to @_navigation.CategoryName
                        </a>
                    }

                    <a href="@Context.Links.Search.Href" class="inline-flex items-center rounded bg-amber-500 px-4 py-2 font-semibold text-white hover:bg-amber-600">
                        Browse Products
                    </a>

                    <a href="@Context.Links.Home.Href" class="inline-flex items-center rounded bg-white px-4 py-2 font-semibold text-neutral-900 ring-1 ring-black/5 hover:bg-neutral-100">
                        Back to Home
                    </a>
                </div>

                <div class="mt-8 rounded-2xl border border-amber-200 bg-amber-50 px-4 py-4 text-sm leading-6 text-amber-900">
                    Questions about sizing, delivery, or returns? Visit <a href="@Context.Links.CustomerService.Href" class="font-semibold underline">@Context.Links.CustomerService.Label</a> before you place your order.
                </div>
                </div>
            </div>
        </ChildContent>
    </StorefrontPageShell>

    <SeoContentSection Title="@ProductSeoContentTitle"
                       Eyebrow="Product Details"
                       Content="@_product.SeoContent" />

    <section class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8">
        <div class="rounded-3xl border border-neutral-200/70 bg-white/90 p-8 shadow-lg">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-neutral-500">Keep Exploring</p>

            @if (_relatedProducts.Count > 0)
            {
                <h2 class="mt-2 text-2xl font-extrabold tracking-tight text-neutral-900">More from @_navigation.CategoryName</h2>
                <div class="mt-8">
                    <ProductGrid Items="_relatedProducts" EmptyMessage="No additional related products are available right now." />
                </div>
            }
            else
            {
                <h2 class="mt-2 text-2xl font-extrabold tracking-tight text-neutral-900">Keep browsing the public catalog</h2>
                <div class="mt-6 flex flex-wrap gap-3">
                    @if (!string.IsNullOrWhiteSpace(_navigation.CategoryUrl) && !string.IsNullOrWhiteSpace(_navigation.CategoryName))
                    {
                        <a href="@_navigation.CategoryUrl" class="inline-flex items-center rounded bg-neutral-900 px-4 py-2 font-semibold text-white hover:bg-neutral-800">
                            Explore @_navigation.CategoryName
                        </a>
                    }

                    <a href="@Context.Links.Search.Href" class="inline-flex items-center rounded bg-amber-500 px-4 py-2 font-semibold text-white hover:bg-amber-600">
                        Browse Products
                    </a>

                    <a href="@Context.Links.Home.Href" class="inline-flex items-center rounded bg-white px-4 py-2 font-semibold text-neutral-900 ring-1 ring-black/5 hover:bg-neutral-100">
                        Back to Home
                    </a>
                </div>
            }
        </div>
    </section>

@code {
    [Parameter, EditorRequired]
    public StorefrontProductPageContext Context { get; set; } = default!;

    private GetProduct _product => Context.Product;

    private IReadOnlyList<StorefrontBreadcrumbItem> _breadcrumbs => Context.Breadcrumbs;

    private IReadOnlyList<ProductGalleryItem> _galleryItems => Context.GalleryItems;

    private ProductPurchasePanelModel _purchasePanel => Context.PurchasePanel;

    private StorefrontProductPricingView _pricing => Context.Pricing;

    private StorefrontProductAvailabilityView _availability => Context.Availability;

    private StorefrontProductPurchaseView _purchase => Context.Purchase;

    private IReadOnlyList<StorefrontProductVariantView> _variants => Context.Variants;

    private StorefrontProductBadgeView _badges => Context.Badges;

    private StorefrontProductNavigationView _navigation => Context.Navigation;

    private IReadOnlyList<ProductSummaryItem> _relatedProducts => Context.RelatedProductSummaries;

    private string ProductSeoContentTitle => _navigation.ProductSeoContentTitle;

}

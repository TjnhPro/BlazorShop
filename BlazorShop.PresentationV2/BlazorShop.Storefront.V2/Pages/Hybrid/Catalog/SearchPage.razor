@namespace BlazorShop.Storefront.V2.Pages.Catalog
@using BlazorShop.Storefront.Components.Contracts.Navigation
@using BlazorShop.Storefront.Components.Primitives.Navigation
@using BlazorShop.Storefront.Components.Ssr.Catalog
@using BlazorShop.Storefront.Presentation.Models
@using BlazorShop.Storefront.Presentation.Services.Catalog

<section class="mx-auto max-w-7xl px-4 pb-6 pt-10 sm:px-6 lg:px-8">
    <div class="rounded-2xl border border-neutral-200/70 bg-white/90 p-6 shadow-lg">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div>
                <p class="text-sm font-semibold uppercase tracking-[0.2em] text-neutral-500">Search</p>
                <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-neutral-900">@TitleText</h1>
                <p class="mt-3 max-w-3xl text-sm leading-6 text-neutral-700">@ScopeText</p>
            </div>

            <StorefrontCatalogFilterPanel Action="@Context.Links.Search.Href"
                                           Classes="SearchFilterClasses"
                                           Labels="SearchFilterLabels"
                                           Role="search"
                                           ShowCategory="true"
                                           Categories="Context.SearchCategories"
                                           CategorySlug="@Context.Category"
                                           ShowSearch="true"
                                           SearchTerm="@Context.Q"
                                           ShowPriceRange="true"
                                           MinPrice="Context.MinPrice"
                                           MaxPrice="Context.MaxPrice"
                                           ShowSort="true"
                                           SortBy="Context.SortBy"
                                           ShowPageSize="true"
                                           PageSize="Context.PageSize"
                                           ShowStock="true"
                                           InStock="Context.InStock">
                <SubmitIcon>
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
                        <circle cx="11" cy="11" r="7" />
                        <path d="m21 21-4.35-4.35" />
                    </svg>
                </SubmitIcon>
            </StorefrontCatalogFilterPanel>
        </div>
    </div>
</section>

<section class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8">
    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <h2 class="text-2xl font-extrabold tracking-tight text-neutral-900">Results</h2>
        <span class="inline-flex items-center rounded-full bg-white/80 px-4 py-2 text-sm font-semibold text-neutral-700 shadow">@ResultCountText</span>
    </div>

    @if (Context.IsSearchTermTooShort)
    {
        <div class="mb-6 rounded border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-900">
            Enter at least @CatalogSearchPolicy.MinimumSearchTermLength characters to search products.
        </div>
    }

    <StorefrontProductSummaryGrid Items="Context.ProductSummaries" EmptyMessage="No products found" />

    <StorefrontPagination Items="PaginationItems"
                         Classes="SearchPaginationClasses"
                         Labels="SearchPaginationLabels" />
</section>

@code {
    [Parameter, EditorRequired]
    public StorefrontSearchPageContext Context { get; set; } = default!;

    private string TitleText => string.IsNullOrWhiteSpace(Context.Q)
        ? "Browse products"
        : $"Search results for \"{Context.Q.Trim()}\"";

    private string ScopeText => string.IsNullOrWhiteSpace(Context.Category)
        ? "Showing published products across the store."
        : $"Showing published products in {Context.Category.Trim()}.";

    private string ResultCountText => Context.TotalCount == 1 ? "1 item" : $"{Context.TotalCount} items";

    private IReadOnlyList<StorefrontPaginationItem> PaginationItems => Enumerable
        .Range(1, Context.TotalPages)
        .Select(pageNumber => new StorefrontPaginationItem(
            pageNumber,
            Context.Links.SearchUrl(
                Context.Q,
                Context.Category,
                pageNumber,
                Context.PageSize,
                Context.SortBy,
                Context.MinPrice,
                Context.MaxPrice,
                Context.InStock ? true : null),
            pageNumber == Context.PageNumber))
        .ToArray();

    private static StorefrontPaginationClasses SearchPaginationClasses { get; } = new(
        Root: "mt-8 flex flex-wrap items-center justify-center gap-2",
        Link: "inline-flex min-h-10 min-w-10 items-center justify-center rounded border px-3 text-sm font-semibold",
        CurrentLink: "border-neutral-900 bg-neutral-900 text-white",
        InactiveLink: "border-neutral-200 bg-white text-neutral-900 hover:bg-neutral-100");

    private static StorefrontPaginationLabels SearchPaginationLabels { get; } = new("Search result pages");

    private static StorefrontCatalogFilterPanelClasses SearchFilterClasses { get; } = new(
        Root: "grid gap-3 md:grid-cols-4 xl:grid-cols-8",
        Input: "rounded border border-neutral-300 bg-white px-4 py-3 text-sm text-neutral-900",
        Select: "rounded border border-neutral-300 bg-white px-3 py-3 text-sm font-semibold text-neutral-900",
        CheckboxLabel: "flex items-center gap-2 rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm font-semibold text-neutral-700",
        SubmitButton: "inline-flex items-center justify-center gap-2 rounded bg-amber-500 px-4 py-3 text-sm font-semibold text-white hover:bg-amber-600");

    private static StorefrontCatalogFilterPanelLabels SearchFilterLabels { get; } = new(
        AllCategories: "All",
        SearchPlaceholder: "Search products",
        MinPricePlaceholder: "Min price",
        MaxPricePlaceholder: "Max price",
        SortAriaLabel: "Sort products",
        CategoryAriaLabel: "Filter by category",
        PageSizeAriaLabel: "Products per page",
        FeaturedSort: "Featured",
        RecentlyUpdatedSort: "Recently updated",
        PriceLowSort: "Price low",
        PriceHighSort: "Price high",
        NewestSort: "Newest",
        InStock: "In stock",
        Submit: "Search",
        PerPageSuffix: "per page");
}

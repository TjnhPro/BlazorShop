@namespace BlazorShop.Storefront.V2.Pages.Catalog
@using BlazorShop.Storefront.Components.Contracts.Navigation
@using BlazorShop.Storefront.Components.Primitives.Navigation
@using BlazorShop.Storefront.Components.Ssr.Catalog
@using BlazorShop.Storefront.Presentation.Services.Catalog

<StorefrontPageShell Class="mx-auto max-w-7xl px-4 pb-6 pt-10 sm:px-6 lg:px-8">
    <Breadcrumb>
        <BreadcrumbNav Items="Context.Breadcrumbs" />
    </Breadcrumb>

    <ChildContent>
        <div class="rounded-3xl border border-neutral-200/70 bg-white/90 p-8 shadow-lg">
            <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
                <div>
                    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-neutral-500">Category</p>
                    <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-neutral-900">@Context.CategoryPage.Category.Name</h1>
                    @if (!string.IsNullOrWhiteSpace(Context.CategoryPage.Category.Description))
                    {
                        <p class="mt-4 max-w-3xl text-base leading-7 text-neutral-700">@Context.CategoryPage.Category.Description</p>
                    }
                    else if (!string.IsNullOrWhiteSpace(Context.CategoryPage.Category.MetaDescription))
                    {
                        <p class="mt-4 max-w-3xl text-base leading-7 text-neutral-700">@Context.CategoryPage.Category.MetaDescription</p>
                    }
                </div>

                <div class="flex flex-wrap items-center gap-3">
                    <span class="inline-flex items-center rounded-full bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-800 shadow">@CategoryResultCountText</span>
                    <a href="@Context.Links.Home.Href" class="inline-flex items-center rounded bg-amber-500 px-4 py-2 font-semibold text-white hover:bg-amber-600">Back to Home</a>
                </div>
            </div>

            <StorefrontCatalogFilterPanel Classes="CategoryFilterClasses"
                                           Labels="CategoryFilterLabels"
                                           ShowPriceRange="true"
                                           MinPrice="Context.MinPrice"
                                           MaxPrice="Context.MaxPrice"
                                           ShowSort="true"
                                           SortBy="Context.SortBy"
                                           ShowPageSize="true"
                                           PageSize="Context.PageSize"
                                           ShowStock="true"
                                           InStock="Context.InStock" />
        </div>
    </ChildContent>
</StorefrontPageShell>

<section class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8">
    <StorefrontProductSummaryGrid Items="Context.ProductSummaries"
                                  EmptyMessage="No products are available in this category right now." />

    <StorefrontPagination Items="PaginationItems"
                         Classes="CategoryPaginationClasses"
                         Labels="CategoryPaginationLabels" />
</section>

<SeoContentSection Title="@CategorySeoContentTitle"
                   Eyebrow="Category Guide"
                   Content="@Context.CategoryPage.Category.SeoContent" />

@code {
    [Parameter, EditorRequired]
    public StorefrontCategoryPageContext Context { get; set; } = default!;

    private string CategorySeoContentTitle => $"More about {Context.CategoryPage.Category.Name}";

    private string CategoryResultCountText => Context.TotalCount == 1 ? "1 item" : $"{Context.TotalCount} items";

    private IReadOnlyList<StorefrontPaginationItem> PaginationItems => Enumerable
        .Range(1, Context.TotalPages)
        .Select(pageNumber => new StorefrontPaginationItem(
            pageNumber,
            Context.Links.CategoryUrl(
                Context.Slug,
                pageNumber,
                Context.PageSize,
                Context.SortBy,
                Context.MinPrice,
                Context.MaxPrice,
                Context.InStock ? true : null),
            pageNumber == Context.PageNumber))
        .ToArray();

    private static StorefrontPaginationClasses CategoryPaginationClasses { get; } = new(
        Root: "mt-8 flex flex-wrap items-center justify-center gap-2",
        Link: "inline-flex min-h-10 min-w-10 items-center justify-center rounded border px-3 text-sm font-semibold",
        CurrentLink: "border-neutral-900 bg-neutral-900 text-white",
        InactiveLink: "border-neutral-200 bg-white text-neutral-900 hover:bg-neutral-100");

    private static StorefrontPaginationLabels CategoryPaginationLabels { get; } = new("Category product pages");

    private static StorefrontCatalogFilterPanelClasses CategoryFilterClasses { get; } = new(
        Root: "mt-6 grid gap-3 rounded-2xl border border-neutral-200 bg-neutral-50/80 p-4 md:grid-cols-3 xl:grid-cols-6",
        Input: "rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm text-neutral-900 focus:outline-none focus:ring-1 focus:ring-black/10",
        Select: "rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm text-neutral-900 focus:outline-none focus:ring-1 focus:ring-black/10",
        CheckboxLabel: "flex items-center gap-2 rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm font-semibold text-neutral-700",
        SubmitButton: "inline-flex items-center justify-center rounded bg-neutral-900 px-4 py-3 text-sm font-semibold text-white hover:bg-neutral-800");

    private static StorefrontCatalogFilterPanelLabels CategoryFilterLabels { get; } = new(
        AllCategories: "All",
        SearchPlaceholder: "Search products",
        MinPricePlaceholder: "Min price",
        MaxPricePlaceholder: "Max price",
        SortAriaLabel: "Sort products",
        CategoryAriaLabel: "Filter by category",
        PageSizeAriaLabel: "Products per page",
        FeaturedSort: "Featured",
        RecentlyUpdatedSort: "Recently updated",
        PriceLowSort: "Price low",
        PriceHighSort: "Price high",
        NewestSort: "Newest",
        InStock: "In stock",
        Submit: "Apply",
        PerPageSuffix: "per page");
}

@using BlazorShop.Storefront.Presentation.Services.Cart
@using BlazorShop.Storefront.Services.Contracts

<StorefrontCartView InitialCart="Context.Cart"
                    InitialAlerts="Context.Alerts"
                    DataMode="StorefrontFeatureDataMode.InitialSnapshot"
                    Actions="StorefrontCartViewOptions.Actions"
                    Classes="StorefrontCartViewOptions.Classes"
                    CheckoutUrl="@Context.CheckoutUrl"
                    NewReleasesUrl="@Context.NewReleasesUrl"
                    TodaysDealsUrl="@Context.TodaysDealsUrl"
                    @rendermode="InteractiveWebAssembly" />

@code {
    [Parameter]
    public StorefrontCartPageContext Context { get; set; } = new(
        null,
        [],
        StorefrontLinkContext.Default.Checkout.Href,
        StorefrontLinkContext.Default.NewReleases.Href,
        StorefrontLinkContext.Default.TodaysDeals.Href,
        StorefrontLinkContext.Default);
}

@using BlazorShop.Storefront.Presentation.Services.Checkout

<section class="mx-auto max-w-7xl px-4 pb-12 pt-10 sm:px-6 lg:px-8">
    @if (Context.HasOrderReference)
    {
        <div class="rounded-3xl border border-emerald-200 bg-emerald-50 px-6 py-10 text-center shadow-sm">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-emerald-700">Order placed</p>
            <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-emerald-950">Thank you</h1>
            <p class="mt-3 text-base text-emerald-900">Your order reference is <span class="font-mono font-bold">@Context.OrderReference</span>.</p>
            <a href="@Context.Links.Home.Href" class="mt-6 inline-flex items-center rounded bg-neutral-900 px-4 py-3 font-semibold text-white hover:bg-neutral-800">Continue shopping</a>
        </div>
    }
    else if (Context.Lines.Count == 0)
    {
        <StorefrontCheckoutShell InitialState="Context.CheckoutState"
                                 DataMode="StorefrontFeatureDataMode.InitialSnapshot"
                                 Actions="StorefrontCheckoutShellOptions.Actions"
                                 Classes="StorefrontCheckoutShellOptions.Classes"
                                 ShowPanel="false"
                                 @rendermode="InteractiveWebAssembly" />
        <div class="rounded-3xl border border-dashed border-neutral-300 bg-white/80 px-6 py-10 text-center shadow-sm">
            <h1 class="text-3xl font-extrabold tracking-tight text-neutral-900">Your cart is empty</h1>
            <p class="mx-auto mt-3 max-w-xl text-base leading-7 text-neutral-700">Add products before continuing to checkout.</p>
            <a href="@Context.Links.NewReleases.Href" class="mt-6 inline-flex items-center rounded bg-neutral-900 px-4 py-3 font-semibold text-white hover:bg-neutral-800">Shop New Releases</a>
        </div>
    }
    else
    {
        <StorefrontCheckoutShell InitialState="Context.CheckoutState"
                                 DataMode="StorefrontFeatureDataMode.InitialSnapshot"
                                 Actions="StorefrontCheckoutShellOptions.Actions"
                                 Classes="StorefrontCheckoutShellOptions.Classes"
                                 ShowPanel="false"
                                 @rendermode="InteractiveWebAssembly" />
        <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_380px] lg:items-start">
            <article class="rounded-3xl border border-neutral-200/70 bg-white/95 shadow-lg">
                <header class="border-b border-neutral-200 px-6 py-7 sm:px-8">
                    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-neutral-500">Storefront checkout</p>
                    <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-neutral-900">Checkout</h1>
                    <p class="mt-3 max-w-2xl text-base leading-7 text-neutral-700">Enter contact and shipping details to place this order.</p>
                </header>

                <div class="px-6 py-7 sm:px-8">
                    @if (!string.IsNullOrWhiteSpace(Context.Error))
                    {
                        <div class="mb-5 rounded-2xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm font-medium text-rose-800" role="alert">
                            @Context.Error
                        </div>
                    }

                    @if (Context.PaymentMethods.Count == 0)
                    {
                        <div class="rounded-2xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">No payment method is currently available.</div>
                    }
                    else
                    {
                        <StorefrontCheckoutForm Context="Context" FormClass="space-y-6">
                            <StorefrontCheckoutAddressFields Context="Context"
                                                            ContactSectionClass="grid gap-4 md:grid-cols-2"
                                                            AddressSectionClass="space-y-4"
                                                            AddressGridClass="grid gap-4 md:grid-cols-2"
                                                            LabelClass="block text-sm"
                                                            AddressLineClass="block text-sm md:col-span-2"
                                                            LabelTextClass="font-semibold text-neutral-800"
                                                            InputClass="@InputClass"
                                                            UppercaseInputClass="@UppercaseInputClass"
                                                            HeadingClass="text-lg font-bold text-neutral-950" />

                            <StorefrontCheckoutPaymentFields Context="Context"
                                                            SectionClass="space-y-3"
                                                            HeadingClass="text-lg font-bold text-neutral-950"
                                                            OptionLabelClass="flex cursor-pointer items-start gap-3 rounded-2xl border border-neutral-200 bg-neutral-50 p-4 text-sm hover:bg-neutral-100"
                                                            RadioClass="mt-1"
                                                            OptionTitleClass="block font-bold text-neutral-950"
                                                            OptionDescriptionClass="mt-1 block text-neutral-600" />

                            <StorefrontCheckoutSubmit Class="inline-flex w-full items-center justify-center rounded bg-amber-500 px-4 py-3 font-semibold text-white hover:bg-amber-600">
                                Place order
                            </StorefrontCheckoutSubmit>
                        </StorefrontCheckoutForm>
                    }
                </div>
            </article>

            <aside class="rounded-3xl border border-neutral-200/70 bg-white/95 p-6 shadow-lg">
                <p class="text-sm font-semibold uppercase tracking-[0.2em] text-neutral-500">Order Summary</p>
                <div class="mt-5 divide-y divide-neutral-100">
                    @foreach (var line in Context.Lines)
                    {
                        <div class="flex gap-3 py-3 text-sm">
                            <div class="flex-1">
                                <div class="font-semibold text-neutral-950">@line.DisplayName</div>
                                <div class="mt-1 text-neutral-500">Qty @line.Quantity</div>
                            </div>
                            <div class="font-semibold text-neutral-900">@line.LineTotalDisplay</div>
                        </div>
                    }
                </div>
                @if (Context.ServerSubtotal.HasValue)
                {
                    <div class="mt-5 space-y-2 border-t border-neutral-200 pt-4 text-sm text-neutral-700">
                        <div class="flex items-center justify-between">
                            <span>Subtotal</span>
                            <span>@Context.ServerSubtotalDisplay</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span>Shipping</span>
                            <span>@Context.ServerShippingTotalDisplay</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span>Tax</span>
                            <span>@Context.ServerTaxTotalDisplay</span>
                        </div>
                        @if (Context.ServerDiscountTotal.GetValueOrDefault() != 0m)
                        {
                            <div class="flex items-center justify-between">
                                <span>Discount</span>
                                <span>@Context.ServerDiscountTotalDisplay</span>
                            </div>
                        }
                    </div>
                }
                <div class="mt-5 flex items-center justify-between border-t border-neutral-200 pt-4 text-base font-black text-neutral-950">
                    <span>Total</span>
                    <span>@Context.GrandTotalDisplay</span>
                </div>
            </aside>
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public StorefrontCheckoutPageContext Context { get; set; } = default!;

    private const string InputClass = "mt-2 min-h-11 w-full rounded-xl border border-neutral-300 bg-white px-3 text-sm text-neutral-900 outline-none focus:border-neutral-600 focus:ring-2 focus:ring-neutral-100";
    private const string UppercaseInputClass = "mt-2 min-h-11 w-full rounded-xl border border-neutral-300 bg-white px-3 text-sm uppercase text-neutral-900 outline-none focus:border-neutral-600 focus:ring-2 focus:ring-neutral-100";
}
